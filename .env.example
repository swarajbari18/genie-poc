# =============================================================================
# DATABASE — NeonDB
# =============================================================================

# Direct connection URL — used by Better Auth and Drizzle migrations
# Get from: NeonDB console → your project → Connection Details → Direct
# MUST be quoted — the URL contains ? and & which the shell misinterprets if unquoted
DATABASE_URL="postgresql://USER:PASSWORD@HOST/genie_poc?sslmode=require&channel_binding=require"

# Pooled connection URL — used by Drizzle for all app queries at runtime
# Get from: NeonDB console → your project → Connection Details → Pooled
# MUST be quoted — same reason as above
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@HOST-pooler/genie_poc?sslmode=require&channel_binding=require"

# =============================================================================
# GOOGLE OAUTH
# =============================================================================

# Get from: Google Cloud Console → APIs & Services → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx

# =============================================================================
# BETTER AUTH
# =============================================================================

# A random 64-character hex string. Used to sign and verify session cookies.
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The URL of this backend server. Used by Better Auth to build OAuth redirect URLs.
# Local dev: http://localhost:8080
# Production: your Cloud Run URL (fill in after deploy)
BETTER_AUTH_URL=http://localhost:8080

# =============================================================================
# GCP / GOOGLE CLOUD STORAGE
# =============================================================================

# Your GCP project ID
GOOGLE_CLOUD_PROJECT=genie-poc

# The GCS bucket name where contract PDFs are stored
GCS_BUCKET_NAME=genie-poc-contracts

# =============================================================================
# POSTMARK
# =============================================================================

# Get from: Postmark → your server → API Tokens tab
POSTMARK_SERVER_API_TOKEN=

# A username you choose — Postmark will send this in the Authorization header
# when it calls your inbound webhook. You verify it on your backend.
# Can be any string, e.g: postmark-inbound
POSTMARK_INBOUND_WEBHOOK_USER=postmark-inbound

# A password you generate — paired with the username above.
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
POSTMARK_INBOUND_WEBHOOK_PASS=

# =============================================================================
# FRONTEND
# =============================================================================

# The URL of the Astro frontend.
# Local dev: http://localhost:4321
# Production: your Cloudflare Workers URL (fill in after deploy)
FRONTEND_URL=http://localhost:4321

# The URL of the backend, as seen by the browser (used by the Astro frontend).
# Must match BETTER_AUTH_URL.
# Local dev: http://localhost:8080
# Production: your Cloud Run URL (fill in after deploy)
PUBLIC_API_URL=http://localhost:8080

# =============================================================================
# MAIL DOMAIN (Components 1, 4, 8)
# =============================================================================

# The inbound routing domain configured in Postmark (e.g. mail.yourdomain.com).
# Used to build service email addresses and email threading headers.
# Changes per organisation / deployment.
MAIL_DOMAIN=mail.yourdomain.com

# =============================================================================
# BOLDSIGN (Component 8 — embedded signing)
# =============================================================================

# Get from: BoldSign dashboard → API → API Keys
# The free Developer Sandbox key is fine; it watermarks documents but
# accepts arbitrary signer emails.
BOLDSIGN_API_KEY=

# Get from: BoldSign dashboard → API → Webhooks → (your endpoint) → Secret
# Used to verify HMAC-SHA256 signatures on inbound BoldSign webhook events.
BOLDSIGN_WEBHOOK_SECRET=

# =============================================================================
# GOOGLE GEMINI (Component 9)
# =============================================================================

# Get from: Google AI Studio → API Keys
# If unset, AI diff still runs but the plain-English summary is skipped.
GEMINI_API_KEY=