---
import AppLayout from '../layouts/AppLayout.astro'

const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080'
const cookieHeader = Astro.request.headers.get('cookie') ?? ''

let user: any = null
let projectsData: any[] = []

try {
  const sessionRes = await fetch(`${apiUrl}/api/auth/get-session`, {
    headers: { cookie: cookieHeader },
  })
  if (!sessionRes.ok) return Astro.redirect('/')
  const session = await sessionRes.json()
  if (!session?.user) return Astro.redirect('/')
  user = session.user
} catch {
  return Astro.redirect('/?error=service_unavailable')
}

// Pre-select project from query param
const preselectedProjectId = Astro.url.searchParams.get('projectId') ?? ''

try {
  const projRes = await fetch(`${apiUrl}/api/projects`, { headers: { cookie: cookieHeader } })
  if (projRes.ok) {
    const body = await projRes.json()
    projectsData = body.projects ?? []
  }
} catch {}
---

<AppLayout title="New Contract — Genie AI" user={user} apiUrl={apiUrl}>
  <main class="cr-main">

    <div class="cr-back">
      <a href="/dashboard" class="back-link">← Contracts</a>
    </div>

    <header class="cr-header">
      <h1 class="cr-heading">New contract</h1>
      <p class="cr-sub">Describe what you need and Genie will generate a professional contract. Takes about 20 seconds.</p>
    </header>

    <div class="cr-card">
      <form id="createForm" class="cr-form">

        <div class="cr-row cr-row--2">
          <div class="cr-field">
            <label class="cr-label" for="crTitle">Contract title <span class="cr-req">*</span></label>
            <input type="text" id="crTitle" class="form-input" placeholder="Mutual NDA with Acme Corp" required />
          </div>
          <div class="cr-field">
            <label class="cr-label" for="crType">Contract type</label>
            <select id="crType" class="form-input">
              <option value="Non-Disclosure Agreement (NDA)">Non-Disclosure Agreement (NDA)</option>
              <option value="Service Agreement">Service Agreement</option>
              <option value="Independent Contractor Agreement">Independent Contractor Agreement</option>
              <option value="Employment Agreement">Employment Agreement</option>
              <option value="Partnership Agreement">Partnership Agreement</option>
              <option value="License Agreement">License Agreement</option>
              <option value="Consulting Agreement">Consulting Agreement</option>
              <option value="Letter of Intent">Letter of Intent</option>
              <option value="custom">Custom (describe below)</option>
            </select>
          </div>
        </div>

        <div class="cr-row cr-row--2">
          <div class="cr-field">
            <label class="cr-label" for="crPartyA">Your party name <span class="cr-req">*</span></label>
            <input type="text" id="crPartyA" class="form-input" placeholder="Your company or your name" required value={user?.name ?? ''} />
          </div>
          <div class="cr-field">
            <label class="cr-label" for="crPartyB">Counterparty name <span class="cr-req">*</span></label>
            <input type="text" id="crPartyB" class="form-input" placeholder="The other party's name" required />
          </div>
        </div>

        <div class="cr-field">
          <label class="cr-label" for="crDesc">Additional details <span class="cr-opt">(optional)</span></label>
          <textarea
            id="crDesc"
            class="form-input cr-textarea"
            rows="3"
            placeholder="Payment terms, jurisdiction, special clauses, anything important…"
          ></textarea>
        </div>

        <div class="cr-field">
          <label class="cr-label" for="crProject">Add to project <span class="cr-opt">(optional)</span></label>
          <select id="crProject" class="form-input">
            <option value="">No project</option>
            {projectsData.map((p: any) => (
              <option value={p.id} selected={p.id === preselectedProjectId}>{p.name}</option>
            ))}
          </select>
        </div>

        <p id="crError" class="cr-error"></p>

        <div class="cr-actions">
          <button type="submit" id="crSubmitBtn" class="btn-primary btn-lg cr-submit">
            <span id="crBtnText">Generate contract</span>
            <svg id="crSpinner" class="cr-spinner" hidden width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2.5" stroke-dasharray="28" stroke-dashoffset="10" />
            </svg>
          </button>
          <a href="/dashboard" class="btn-ghost">Cancel</a>
        </div>

      </form>
    </div>

    {/* ── Progress overlay ───────────────────────────────────────── */}
    <div class="cr-progress-overlay" id="crProgress" hidden>
      <div class="cr-progress-card">
        <div class="cr-progress-anim" aria-hidden="true">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none">
            <path d="M12 2 L20 7 V17 L12 22 L4 17 V7 Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" fill="none" />
            <path d="M12 7 V12 L15.5 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
        <p class="cr-progress-text" id="crProgressText">Genie is drafting your contract…</p>
        <p class="cr-progress-sub">Usually takes 15–25 seconds</p>
      </div>
    </div>

  </main>
</AppLayout>

<style>
  .cr-main {
    max-width: 640px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .cr-back { margin-bottom: 1.25rem; }

  .cr-header { margin-bottom: 1.75rem; }

  .cr-heading {
    margin: 0 0 0.375rem;
    font-size: 1.5rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
  }

  .cr-sub {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }

  .cr-card {
    background: var(--color-bg-white);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    padding: 1.75rem 2rem;
  }

  .cr-form { display: flex; flex-direction: column; gap: 1rem; }

  .cr-row { display: grid; gap: 0.875rem; }
  .cr-row--2 { grid-template-columns: 1fr 1fr; }

  @media (max-width: 560px) { .cr-row--2 { grid-template-columns: 1fr; } }

  .cr-field { display: flex; flex-direction: column; gap: 0.35rem; }

  .cr-label {
    font-size: 0.875rem;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }

  .cr-req { color: var(--color-accent); }
  .cr-opt { font-weight: normal; color: var(--color-text-muted); }

  .cr-textarea { min-height: 80px; resize: vertical; }

  .cr-error {
    color: #dc2626;
    font-size: 0.875rem;
    margin: 0;
    min-height: 1.25em;
  }

  .cr-actions {
    display: flex;
    gap: 0.625rem;
    align-items: center;
    margin-top: 0.25rem;
  }

  .cr-submit {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .cr-spinner {
    animation: spin-cr 0.9s linear infinite;
  }

  @keyframes spin-cr {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }

  /* ── Progress overlay ─────────────────────────────────────────── */
  .cr-progress-overlay {
    position: fixed;
    inset: 0;
    background: rgba(255,255,255,0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
  }

  .cr-progress-card {
    text-align: center;
    padding: 2.5rem 2rem;
  }

  .cr-progress-anim {
    color: var(--color-accent);
    margin: 0 auto 1.5rem;
    display: inline-flex;
    animation: float-logo 2s ease-in-out infinite;
  }

  @keyframes float-logo {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  .cr-progress-text {
    margin: 0 0 0.375rem;
    font-size: 1.0625rem;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }

  .cr-progress-sub {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
</style>

<script define:vars={{ apiUrl }}>
  const form = document.getElementById('createForm')
  const crError = document.getElementById('crError')
  const crProgress = document.getElementById('crProgress')
  const crProgressText = document.getElementById('crProgressText')
  const crSubmitBtn = document.getElementById('crSubmitBtn')
  const crBtnText = document.getElementById('crBtnText')
  const crSpinner = document.getElementById('crSpinner')

  const progressMessages = [
    'Genie is drafting your contract…',
    'Applying standard legal clauses…',
    'Formatting the document…',
    'Almost done…',
  ]

  form?.addEventListener('submit', async (e) => {
    e.preventDefault()

    const title = document.getElementById('crTitle')?.value?.trim()
    const contractType = document.getElementById('crType')?.value
    const partyA = document.getElementById('crPartyA')?.value?.trim()
    const partyB = document.getElementById('crPartyB')?.value?.trim()
    const description = document.getElementById('crDesc')?.value?.trim()
    const projectId = document.getElementById('crProject')?.value || null

    if (!title || !partyA || !partyB) {
      if (crError) crError.textContent = 'Please fill in all required fields.'
      return
    }

    if (crError) crError.textContent = ''
    if (crSubmitBtn) crSubmitBtn.disabled = true
    if (crBtnText) crBtnText.textContent = 'Generating…'
    if (crSpinner) crSpinner.hidden = false
    if (crProgress) crProgress.hidden = false

    // Cycle through progress messages
    let msgIdx = 0
    const msgInterval = setInterval(() => {
      msgIdx = (msgIdx + 1) % progressMessages.length
      if (crProgressText) crProgressText.textContent = progressMessages[msgIdx]
    }, 6000)

    try {
      const res = await fetch(`${apiUrl}/api/generate`, {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title, contractType, partyA, partyB, description, projectId }),
      })

      clearInterval(msgInterval)

      if (!res.ok) {
        const err = await res.json().catch(() => ({}))
        throw new Error(err.error ?? 'Generation failed')
      }

      const data = await res.json()
      if (crProgressText) crProgressText.textContent = 'Contract ready — opening…'
      window.location.href = `/contracts/${data.contractId}`
    } catch (err) {
      clearInterval(msgInterval)
      if (crProgress) crProgress.hidden = true
      if (crError) crError.textContent = err.message ?? 'Something went wrong. Please try again.'
      if (crSubmitBtn) crSubmitBtn.disabled = false
      if (crBtnText) crBtnText.textContent = 'Generate contract'
      if (crSpinner) crSpinner.hidden = true
    }
  })
</script>
