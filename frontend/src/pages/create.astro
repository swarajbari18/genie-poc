---
import AppLayout from '../layouts/AppLayout.astro'

const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080'
const cookieHeader = Astro.request.headers.get('cookie') ?? ''

let user: any = null
let projectsData: any[] = []

try {
  const sessionRes = await fetch(`${apiUrl}/api/auth/get-session`, {
    headers: { cookie: cookieHeader },
  })
  if (!sessionRes.ok) return Astro.redirect('/')
  const session = await sessionRes.json()
  if (!session?.user) return Astro.redirect('/')
  user = session.user
} catch {
  return Astro.redirect('/?error=service_unavailable')
}

const preselectedProjectId = Astro.url.searchParams.get('projectId') ?? ''

try {
  const projRes = await fetch(`${apiUrl}/api/projects`, { headers: { cookie: cookieHeader } })
  if (projRes.ok) projectsData = (await projRes.json()).projects ?? []
} catch {}
---

<AppLayout title="New Contract — Genie AI" user={user} apiUrl={apiUrl}>
  <main class="cr-main">

    <div class="cr-back">
      <a href="/dashboard" class="back-link">← Contracts</a>
    </div>

    <header class="cr-header">
      <h1 class="cr-heading">New contract</h1>
    </header>

    {/* ── Path chooser ─────────────────────────────────────────── */}
    <div class="cr-chooser">
      <span class="cr-chooser__active">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 2L20 7V17L12 22L4 17V7Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
        </svg>
        Generate with AI
      </span>
      <a href="/upload" class="btn-ghost cr-chooser__upload">Upload a PDF</a>
    </div>

    {/* ── Form card ────────────────────────────────────────────── */}
    <div class="cr-card">
      <form id="createForm" class="cr-form" novalidate>

        {/* Primary intent field */}
        <div class="cr-field">
          <textarea
            id="crIntent"
            class="form-input cr-intent"
            rows="5"
            placeholder="Describe the contract — type, parties and their roles, governing law, and any key terms."
            autofocus
          ></textarea>
        </div>

        {/* Optional fields */}
        <div class="cr-secondary">
          <div class="cr-field cr-field--inline">
            <label class="cr-label-sm" for="crName">Contract name</label>
            <input
              type="text"
              id="crName"
              class="form-input cr-name-input"
              placeholder="Optional — auto-named if blank"
            />
          </div>

          {projectsData.length > 0 && (
            <div class="cr-field cr-field--inline">
              <label class="cr-label-sm" for="crProject">Add to project</label>
              <select id="crProject" class="form-input cr-project-select">
                <option value="">No project</option>
                {projectsData.map((p: any) => (
                  <option value={p.id} selected={p.id === preselectedProjectId}>{p.name}</option>
                ))}
              </select>
            </div>
          )}
        </div>

        <p id="crError" class="cr-error"></p>

        <div class="cr-actions">
          <button type="submit" id="crSubmitBtn" class="btn-primary cr-submit" disabled>
            <span id="crBtnText">Generate contract</span>
            <svg id="crSpinner" class="cr-spinner" {...{hidden: true} as object} width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2.5" stroke-dasharray="28" stroke-dashoffset="10" />
            </svg>
          </button>
          <a href="/dashboard" class="btn-ghost">Cancel</a>
        </div>

      </form>
    </div>

    {/* ── Progress overlay (keep exactly) ─────────────────────── */}
    <div class="cr-progress-overlay" id="crProgress" hidden>
      <div class="cr-progress-card">
        <div class="cr-progress-anim" aria-hidden="true">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none">
            <path d="M12 2 L20 7 V17 L12 22 L4 17 V7 Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" fill="none" />
            <path d="M12 7 V12 L15.5 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
        <p class="cr-progress-text" id="crProgressText">Understanding your request…</p>
        <p class="cr-progress-sub">Usually takes 15–25 seconds</p>
      </div>
    </div>

  </main>
</AppLayout>

<style>
  .cr-main {
    max-width: 600px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .cr-back { margin-bottom: 1.25rem; }
  .back-link { color: var(--color-text-muted); text-decoration: none; font-size: 0.9rem; }
  .back-link:hover { color: var(--color-accent); }

  .cr-header { margin-bottom: 1.125rem; }
  .cr-heading {
    margin: 0;
    font-size: 1.5rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
  }

  /* ── Path chooser ──────────────────────────────────────────── */
  .cr-chooser {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.375rem;
  }

  .cr-chooser__active {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent);
    background: var(--color-border-light);
    border: 1.5px solid var(--color-border-mid);
    border-radius: var(--radius-pill);
    padding: 0.375rem 1rem;
  }

  .cr-chooser__upload { font-size: 0.875rem; padding: 0.375rem 1rem; }

  /* ── Card ──────────────────────────────────────────────────── */
  .cr-card {
    background: var(--color-bg-white);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    padding: 1.5rem 1.75rem;
  }

  .cr-form { display: flex; flex-direction: column; gap: 1.375rem; }

  .cr-field { display: flex; flex-direction: column; gap: 0.375rem; }

  .cr-intent {
    min-height: 120px;
    font-size: 1rem;
    line-height: 1.6;
    letter-spacing: 0.005em;
  }

  /* ── Secondary optional fields ──────────────────────────────── */
  .cr-secondary {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .cr-field--inline {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex: 1;
    min-width: 160px;
  }

  .cr-label-sm {
    font-size: 0.8125rem;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .cr-name-input { flex: 1; min-width: 0; }
  .cr-project-select { flex: 1; min-width: 0; }

  /* ── Error ─────────────────────────────────────────────────── */
  .cr-error {
    color: #dc2626;
    font-size: 0.875rem;
    margin: 0;
    min-height: 1.25em;
  }

  /* ── Actions ──────────────────────────────────────────────── */
  .cr-actions { display: flex; gap: 0.75rem; align-items: center; }

  .cr-submit { display: inline-flex; align-items: center; gap: 0.5rem; }

  .cr-spinner { animation: spin-cr 0.9s linear infinite; flex-shrink: 0; }
  @keyframes spin-cr {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }

  /* ── Progress overlay (preserve exactly) ──────────────────── */
  .cr-progress-overlay {
    position: fixed;
    inset: 0;
    background: rgba(255,255,255,0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
  }

  .cr-progress-card { text-align: center; padding: 2.5rem 2rem; }

  .cr-progress-anim {
    color: var(--color-accent);
    margin: 0 auto 1.5rem;
    display: inline-flex;
    animation: float-logo 2s ease-in-out infinite;
  }

  @keyframes float-logo {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-6px); }
  }

  .cr-progress-text {
    margin: 0 0 0.375rem;
    font-size: 1.0625rem;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }

  .cr-progress-sub {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
</style>

<script define:vars={{ apiUrl, defaultPartyA: user?.name ?? '' }}>
  const form           = document.getElementById('createForm')
  const intentEl       = document.getElementById('crIntent')
  const submitBtn      = document.getElementById('crSubmitBtn')
  const btnText        = document.getElementById('crBtnText')
  const spinner        = document.getElementById('crSpinner')
  const errorEl        = document.getElementById('crError')
  const crProgress     = document.getElementById('crProgress')
  const crProgressText = document.getElementById('crProgressText')

  const progressMessages = [
    'Understanding your request…',
    'Drafting your contract…',
    'Applying standard clauses…',
    'Formatting the document…',
    'Almost done…',
  ]

  // Enable button when textarea has text
  intentEl?.addEventListener('input', () => {
    submitBtn.disabled = intentEl.value.trim().length === 0
  })

  form?.addEventListener('submit', async e => {
    e.preventDefault()
    const intent = intentEl?.value?.trim()
    if (!intent) return

    if (errorEl) errorEl.textContent = ''
    submitBtn.disabled = true
    btnText.textContent = 'Generating…'
    spinner.hidden = false
    crProgress.hidden = false

    let msgIdx = 0
    const msgInterval = setInterval(() => {
      msgIdx = (msgIdx + 1) % progressMessages.length
      if (crProgressText) crProgressText.textContent = progressMessages[msgIdx]
    }, 5000)

    try {
      // Step 1: extract structure from the intent (silent, behind overlay)
      let title        = document.getElementById('crName')?.value?.trim() || null
      let contractType = 'Non-Disclosure Agreement (NDA)'
      let partyA       = defaultPartyA
      let partyB       = 'Counterparty'

      try {
        const extRes = await fetch(`${apiUrl}/api/generate/extract`, {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ intent }),
        })
        if (extRes.ok) {
          const ext = await extRes.json()
          if (!title && ext.title)    title        = ext.title
          if (ext.contractType)       contractType = ext.contractType
          if (ext.partiesA?.length)   partyA       = ext.partiesA.join(', ')
          if (ext.partiesB?.length)   partyB       = ext.partiesB.join(', ')
        }
      } catch {}

      // Fallback title from intent first line
      if (!title) {
        title = intent.split(/[.,\n]/)[0].trim().slice(0, 80) || 'New Contract'
      }

      // Step 2: generate
      const projectId = document.getElementById('crProject')?.value || null
      const res = await fetch(`${apiUrl}/api/generate`, {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          title,
          contractType,
          partyA,
          partyB,
          description: intent,
          projectId,
        }),
      })

      clearInterval(msgInterval)

      if (!res.ok) {
        const err = await res.json().catch(() => ({}))
        throw new Error(err.error ?? 'Generation failed')
      }

      const data = await res.json()
      if (crProgressText) crProgressText.textContent = 'Contract ready — opening…'
      window.location.href = `/contracts/${data.contractId}`
    } catch (err) {
      clearInterval(msgInterval)
      crProgress.hidden = false  // keep overlay hidden on error
      crProgress.hidden = true
      if (errorEl) errorEl.textContent = err.message ?? 'Something went wrong. Please try again.'
      submitBtn.disabled = false
      btnText.textContent = 'Generate contract'
      spinner.hidden = true
    }
  })
</script>
