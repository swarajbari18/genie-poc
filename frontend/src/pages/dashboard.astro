---
import AppLayout from '../layouts/AppLayout.astro'

const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080'
const cookieHeader = Astro.request.headers.get('cookie') ?? ''

let user: any = null
let projectsData: any[] = []
let allContracts: any[] = []
let awaitingSig: any[] = []

try {
  const sessionRes = await fetch(`${apiUrl}/api/auth/get-session`, { headers: { cookie: cookieHeader } })
  if (!sessionRes.ok) return Astro.redirect('/')
  const session = await sessionRes.json()
  if (!session?.user) return Astro.redirect('/')
  user = session.user
} catch { return Astro.redirect('/?error=service_unavailable') }

try {
  const [pR, cR] = await Promise.all([
    fetch(`${apiUrl}/api/projects`, { headers: { cookie: cookieHeader } }),
    fetch(`${apiUrl}/api/contracts`, { headers: { cookie: cookieHeader } }),
  ])
  if (pR.ok) projectsData = (await pR.json()).projects ?? []
  if (cR.ok) {
    allContracts = (await cR.json()).contracts ?? []
    awaitingSig = allContracts.filter((c: any) => c.awaitingMySignature)
  }
} catch {}

// ── Helpers ──────────────────────────────────────────────────────────────────
function statusProse(c: any): string {
  const raw = c.recipientName || c.recipientEmail?.split('@')[0] || 'counterparty'
  const n = raw.split(' ')[0]
  switch (c.status) {
    case 'draft':             return 'Draft'
    case 'sent':              return `Waiting on ${n}`
    case 'ai_processing':     return 'Analysing…'
    case 'replied':           return `${n} proposed changes`
    case 'negotiating':       return `Negotiating with ${n}`
    case 'out_for_signature': return 'Awaiting signatures'
    case 'partially_signed':  return 'Partially signed'
    case 'completed':
    case 'signed':            return 'Executed'
    case 'declined':          return `Declined by ${n}`
    case 'received':          return `Received from ${n}`
    default: return c.status
  }
}

function urgency(status: string): string {
  if (['replied','negotiating','received','ai_processing'].includes(status)) return 'urgent'
  if (['out_for_signature','partially_signed'].includes(status)) return 'active'
  if (['signed','completed'].includes(status)) return 'done'
  if (status === 'declined') return 'declined'
  if (status === 'draft') return 'draft'
  return 'neutral'
}

function cta(c: any): string {
  if (c.awaitingMySignature) return 'Sign now'
  switch (c.status) {
    case 'replied': case 'negotiating': case 'ai_processing': case 'received': return 'Review'
    case 'out_for_signature': case 'partially_signed': return 'Track'
    case 'signed': case 'completed': return 'Download'
    case 'sent': return 'View'
    default: return 'Open'
  }
}

function timeAgo(iso?: string): string {
  if (!iso) return ''
  const m = Math.floor((Date.now() - new Date(iso).getTime()) / 60000)
  if (m < 1) return 'just now'
  if (m < 60) return `${m}m ago`
  const h = Math.floor(m / 60)
  if (h < 24) return `${h}h ago`
  const d = Math.floor(h / 24)
  if (d < 7) return `${d}d ago`
  return `${Math.floor(d / 7)}w ago`
}

// contractId → project lookup (for filter)
const contractToProject: Record<string, {id: string, name: string}> = {}
for (const p of projectsData) {
  for (const c of (p.contracts ?? [])) {
    contractToProject[c.id] = { id: p.id, name: p.name }
  }
}

// Three actionability groups
const needsYou = allContracts.filter((c: any) =>
  c.awaitingMySignature || ['replied','negotiating','received','ai_processing'].includes(c.status)
)
const needsYouIds = new Set(needsYou.map((c: any) => c.id))
const waitingOnOthers = allContracts.filter((c: any) =>
  !needsYouIds.has(c.id) && !['signed','completed'].includes(c.status)
)
const done = allContracts.filter((c: any) => ['signed','completed'].includes(c.status))

const isEmpty = allContracts.length === 0
const hasNoProjects = projectsData.length === 0
const projects = projectsData.map((p: any) => ({ id: p.id, name: p.name }))
---

<AppLayout title="Contracts — Genie AI" user={user} apiUrl={apiUrl}>

  <div class="db-page">

    {/* ── Sign-now strip (keep) ──────────────────────────────────────────── */}
    {awaitingSig.length > 0 && (
      <div class="sign-strip">
        <span class="sign-strip__pulse"></span>
        <span class="sign-strip__text">
          {awaitingSig.length === 1
            ? `${awaitingSig[0].title} needs your signature`
            : `${awaitingSig.length} contracts need your signature`}
        </span>
        <a href={`/contracts/${awaitingSig[0].id}`} class="btn-primary sign-strip__cta">Sign now</a>
      </div>
    )}

    {/* ── Empty state ───────────────────────────────────────────────────── */}
    {isEmpty && (
      <div class="empty">
        <div class="empty__icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none">
            <path d="M12 2L20 7V17L12 22L4 17V7Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
            <path d="M12 7V12L15.5 14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h2>Your contract workspace</h2>
        <p>Create contracts with AI, send for review, negotiate, sign.</p>
        <div class="empty__btns">
          <a href="/create" class="btn-primary">Create a contract</a>
        </div>
      </div>
    )}

    {/* ── Toolbar + groups ──────────────────────────────────────────────── */}
    {!isEmpty && (
      <>
        <div class="db-toolbar">
          <a href="/create" class="btn-primary db-toolbar__new">+ New contract</a>
          <button class="btn-ghost db-toolbar__new-proj" id="newProjFromFilter">+ New project</button>

          {projects.length > 0 && (
            <div class="db-filter" id="projectFilter">
              <button class="db-filter__btn" id="filterBtn" aria-haspopup="listbox" aria-expanded="false">
                All projects <span class="db-filter__caret" aria-hidden="true">▾</span>
              </button>
              <div class="db-filter__menu" id="filterMenu" role="listbox" hidden>
                <button class="db-filter__opt db-filter__opt--active" data-filter="all">All projects</button>
                {projects.map((p: any) => (
                  <button class="db-filter__opt" data-filter={p.id}>{p.name}</button>
                ))}
              </div>
            </div>
          )}
        </div>

        <div id="groupsContainer">
          {/* NEEDS YOU */}
          {needsYou.length > 0 && (
            <section class="db-group" id="group-needs-you">
              <div class="db-group__header">
                <span class="db-group__label">NEEDS YOU</span>
                <span class="db-group__count">{needsYou.length}</span>
              </div>
              <div class="db-cards">
                {needsYou.map((c: any) => (
                  <a href={`/contracts/${c.id}`}
                     class="contract-card"
                     data-project={contractToProject[c.id]?.id ?? 'orphan'}
                     data-id={c.id}>
                    <div class="contract-card__thumb">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7l-4-4Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                        <path d="M14 3v4h4" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                        <path d="M8 13h8M8 17h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                      </svg>
                    </div>
                    <div class="contract-card__body">
                      <div class="contract-card__title">{c.title}</div>
                      <div class="contract-card__sub">
                        {statusProse(c)}{c.updatedAt ? ` · ${timeAgo(c.updatedAt)}` : ''}
                      </div>
                    </div>
                    <span class="contract-card__cta">{cta(c)} →</span>
                  </a>
                ))}
              </div>
            </section>
          )}

          {/* WAITING ON OTHERS */}
          {waitingOnOthers.length > 0 && (
            <section class="db-group" id="group-waiting">
              <div class="db-group__header">
                <span class="db-group__label">WAITING ON OTHERS</span>
                <span class="db-group__count">{waitingOnOthers.length}</span>
              </div>
              <div class="db-rows">
                {waitingOnOthers.map((c: any) => (
                  <a href={`/contracts/${c.id}`}
                     class="contract-row"
                     data-project={contractToProject[c.id]?.id ?? 'orphan'}
                     data-id={c.id}>
                    <span class="contract-row__dot" aria-hidden="true">·</span>
                    <span class="contract-row__title">{c.title}</span>
                    <span class="contract-row__sub">
                      {statusProse(c)}{c.updatedAt ? ` · ${timeAgo(c.updatedAt)}` : ''}
                    </span>
                    <span class="contract-row__cta">{cta(c)} →</span>
                  </a>
                ))}
              </div>
            </section>
          )}

          {/* DONE — collapsed by default */}
          {done.length > 0 && (
            <section class="db-group" id="group-done">
              <button class="db-group__header db-group__toggle" id="doneToggle" aria-expanded="false">
                <span class="db-group__label">DONE</span>
                <span class="db-group__count">{done.length}</span>
                <span class="db-group__chevron" aria-hidden="true">▸</span>
              </button>
              <div class="db-rows" id="doneRows" hidden>
                {done.map((c: any) => (
                  <a href={`/contracts/${c.id}`}
                     class="contract-row contract-row--done"
                     data-project={contractToProject[c.id]?.id ?? 'orphan'}
                     data-id={c.id}>
                    <span class="contract-row__dot" aria-hidden="true">·</span>
                    <span class="contract-row__title">{c.title}</span>
                    <span class="contract-row__sub">
                      {statusProse(c)}{c.updatedAt ? ` · ${timeAgo(c.updatedAt)}` : ''}
                    </span>
                    <span class="contract-row__cta">{cta(c)} →</span>
                  </a>
                ))}
              </div>
            </section>
          )}
        </div>
      </>
    )}

  </div>

  {/* ── New project modal (triggered from filter menu) ─────────────────── */}
  <div class="modal-scrim" id="projModal" hidden>
    <div class="modal" role="dialog" aria-modal="true">
      <h2 class="modal__title">New project</h2>
      <form id="projForm">
        <label class="modal__label" for="projName">Name</label>
        <input id="projName" type="text" class="form-input" placeholder="Acme Corp, Q3 Deals…" required autocomplete="off" />
        <label class="modal__label" for="projDesc" style="margin-top:0.75rem">Description <span style="font-weight:400;color:var(--color-text-muted)">(optional)</span></label>
        <input id="projDesc" type="text" class="form-input" placeholder="Brief description" />
        <p id="projErr" class="error-banner"></p>
        <div class="modal__actions">
          <button type="submit" class="btn-primary">Create</button>
          <button type="button" id="projCancel" class="btn-ghost">Cancel</button>
        </div>
      </form>
    </div>
  </div>

</AppLayout>

<style is:global>
/* ── Dashboard page shell ──────────────────────────────────────────────────── */
.db-page {
  max-width: 820px;
  margin: 0 auto;
  padding: 2rem 2.25rem 4rem;
}

/* ── Toolbar ───────────────────────────────────────────────────────────────── */
.db-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1.75rem;
}
.db-toolbar__new {
  font-size: 0.875rem;
  padding: 0.5rem 1rem;
}

/* ── Project filter dropdown ───────────────────────────────────────────────── */
.db-filter {
  position: relative;
}
.db-filter__btn {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  padding: 0.4375rem 0.875rem;
  font: inherit;
  font-size: 0.875rem;
  color: var(--color-text-muted);
  background: var(--color-bg-white);
  border: 1px solid var(--color-border-default);
  border-radius: var(--radius-button);
  cursor: pointer;
  transition: border-color 0.12s, color 0.12s;
}
.db-filter__btn:hover { border-color: var(--color-border-mid); color: var(--color-text-primary); }
.db-filter__btn[aria-expanded="true"] { border-color: var(--color-accent); color: var(--color-accent); }
.db-filter__caret { font-size: 0.75rem; }
.db-filter__menu {
  position: absolute;
  right: 0;
  top: calc(100% + 6px);
  min-width: 180px;
  background: var(--color-bg-white);
  border: 1px solid var(--color-border-default);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-raised);
  z-index: 200;
  overflow: hidden;
  padding: 0.375rem 0;
}
.db-filter__opt {
  display: block;
  width: 100%;
  text-align: left;
  padding: 0.5rem 1rem;
  font: inherit;
  font-size: 0.875rem;
  background: none;
  border: none;
  cursor: pointer;
  color: var(--color-text-primary);
  transition: background 0.1s;
}
.db-filter__opt:hover { background: var(--color-bg-subtle); }
.db-filter__opt--active { color: var(--color-accent); font-weight: var(--font-weight-semibold); }
.db-filter__opt--action { color: var(--color-text-muted); font-size: 0.8125rem; }
.db-filter__divider { height: 1px; background: var(--color-border-default); margin: 0.25rem 0; }

/* ── Group sections ────────────────────────────────────────────────────────── */
.db-group {
  margin-bottom: 2rem;
}
.db-group__header {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 0.625rem;
  background: none;
  border: none;
  padding: 0;
  cursor: default;
  width: 100%;
  text-align: left;
}
.db-group__toggle {
  cursor: pointer;
}
.db-group__label {
  font-size: 0.6875rem;
  font-weight: var(--font-weight-bold);
  letter-spacing: 0.09em;
  color: var(--color-text-muted);
  text-transform: uppercase;
}
.db-group__count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 1.375rem;
  height: 1.375rem;
  padding: 0 0.375rem;
  font-size: 0.6875rem;
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-muted);
  background: var(--color-bg-subtle);
  border: 1px solid var(--color-border-default);
  border-radius: var(--radius-pill);
}
.db-group__chevron {
  font-size: 0.625rem;
  color: var(--color-text-muted);
  margin-left: auto;
  transition: transform 0.18s ease;
}
.db-group__toggle[aria-expanded="true"] .db-group__chevron {
  transform: rotate(90deg);
}

/* ── Contract cards (Needs You) ────────────────────────────────────────────── */
.db-cards {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}
.contract-card {
  display: grid;
  grid-template-columns: 2.75rem 1fr auto;
  align-items: center;
  gap: 0.875rem;
  padding: 0.875rem 1rem;
  background: var(--color-bg-white);
  border: 1px solid var(--color-border-default);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  text-decoration: none;
  color: inherit;
  transition: box-shadow 0.15s, border-color 0.15s, transform 0.15s;
}
.contract-card:hover {
  box-shadow: var(--shadow-raised);
  border-color: var(--color-border-mid);
  transform: translateY(-1px);
}
.contract-card:active { transform: translateY(0); }
.contract-card__thumb {
  width: 2.75rem;
  height: 3.5rem;
  background: var(--color-bg-subtle);
  border: 1px solid var(--color-border-default);
  border-radius: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-muted);
  flex-shrink: 0;
}
.contract-card__body {
  min-width: 0;
}
.contract-card__title {
  font-size: 0.9375rem;
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  margin-bottom: 0.25rem;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.contract-card__sub {
  font-size: 0.8125rem;
  color: var(--color-text-muted);
}
.contract-card__cta {
  flex-shrink: 0;
  font-size: 0.8125rem;
  font-weight: var(--font-weight-semibold);
  white-space: nowrap;
  padding: 0.375rem 0.75rem;
  border-radius: var(--radius-button);
  background: var(--color-accent);
  color: #fff;
  border: 1px solid transparent;
}

/* ── Contract rows (Waiting On Others / Done) ──────────────────────────────── */
.db-rows {
  display: flex;
  flex-direction: column;
}
.contract-row {
  display: grid;
  grid-template-columns: 0.875rem 1fr 1fr auto;
  align-items: center;
  gap: 0.75rem;
  padding: 0.5rem 0.5rem;
  text-decoration: none;
  color: inherit;
  border-radius: 6px;
  transition: background 0.1s;
}
.contract-row:hover { background: var(--color-bg-subtle); }
.contract-row__dot {
  color: var(--color-border-mid);
  font-size: 1.125rem;
  line-height: 1;
  flex-shrink: 0;
}
.contract-row__title {
  font-size: 0.875rem;
  font-weight: var(--font-weight-semibold);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.contract-row__sub {
  font-size: 0.8125rem;
  color: var(--color-text-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.contract-row__cta {
  font-size: 0.8125rem;
  color: var(--color-accent);
  font-weight: var(--font-weight-semibold);
  white-space: nowrap;
}
.contract-row--done .contract-row__title {
  color: var(--color-text-muted);
  font-weight: var(--font-weight-regular);
}
.contract-row--done .contract-row__cta {
  color: var(--color-text-muted);
}
</style>

<script define:vars={{ apiUrl, initialContracts: allContracts, contractProjectMap: contractToProject, projectList: projects }}>
// ── JS copies of SSR helpers (for targeted SSE re-render) ─────────────────
function _statusProse(c) {
  const raw = c.recipientName || (c.recipientEmail?.split('@')[0]) || 'counterparty'
  const n = raw.split(' ')[0]
  switch (c.status) {
    case 'draft':             return 'Draft'
    case 'sent':              return `Waiting on ${n}`
    case 'ai_processing':     return 'Analysing…'
    case 'replied':           return `${n} proposed changes`
    case 'negotiating':       return `Negotiating with ${n}`
    case 'out_for_signature': return 'Awaiting signatures'
    case 'partially_signed':  return 'Partially signed'
    case 'completed':
    case 'signed':            return 'Executed'
    case 'declined':          return `Declined by ${n}`
    case 'received':          return `Received from ${n}`
    default: return c.status
  }
}
function _cta(c) {
  if (c.awaitingMySignature) return 'Sign now'
  switch (c.status) {
    case 'replied': case 'negotiating': case 'ai_processing': case 'received': return 'Review'
    case 'out_for_signature': case 'partially_signed': return 'Track'
    case 'signed': case 'completed': return 'Download'
    case 'sent': return 'View'
    default: return 'Open'
  }
}
function _timeAgo(iso) {
  if (!iso) return ''
  const m = Math.floor((Date.now() - new Date(iso).getTime()) / 60000)
  if (m < 1) return 'just now'
  if (m < 60) return `${m}m ago`
  const h = Math.floor(m / 60)
  if (h < 24) return `${h}h ago`
  const d = Math.floor(h / 24)
  if (d < 7) return `${d}d ago`
  return `${Math.floor(d / 7)}w ago`
}
function _esc(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;')
}
function _isNeedsYou(c) {
  return c.awaitingMySignature || ['replied','negotiating','received','ai_processing'].includes(c.status)
}
function _isDone(c) { return ['signed','completed'].includes(c.status) }

const DOC_ICON = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
  <path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7l-4-4Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
  <path d="M14 3v4h4" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
  <path d="M8 13h8M8 17h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
</svg>`

function _buildCard(c) {
  const projId = contractProjectMap[c.id]?.id ?? 'orphan'
  const sub = _statusProse(c) + (c.updatedAt ? ` · ${_timeAgo(c.updatedAt)}` : '')
  return `<a href="/contracts/${_esc(c.id)}" class="contract-card" data-project="${_esc(projId)}" data-id="${_esc(c.id)}">
    <div class="contract-card__thumb">${DOC_ICON}</div>
    <div class="contract-card__body">
      <div class="contract-card__title">${_esc(c.title)}</div>
      <div class="contract-card__sub">${_esc(sub)}</div>
    </div>
    <span class="contract-card__cta">${_esc(_cta(c))} →</span>
  </a>`
}

function _buildRow(c, isDoneRow) {
  const projId = contractProjectMap[c.id]?.id ?? 'orphan'
  const sub = _statusProse(c) + (c.updatedAt ? ` · ${_timeAgo(c.updatedAt)}` : '')
  const cls = isDoneRow ? 'contract-row contract-row--done' : 'contract-row'
  return `<a href="/contracts/${_esc(c.id)}" class="${cls}" data-project="${_esc(projId)}" data-id="${_esc(c.id)}">
    <span class="contract-row__dot" aria-hidden="true">·</span>
    <span class="contract-row__title">${_esc(c.title)}</span>
    <span class="contract-row__sub">${_esc(sub)}</span>
    <span class="contract-row__cta">${_esc(_cta(c))} →</span>
  </a>`
}

// ── Targeted re-render ────────────────────────────────────────────────────
let currentContracts = initialContracts

function _activeFilter() {
  return document.querySelector('.db-filter__opt--active')?.dataset.filter ?? 'all'
}

function _renderGroups(contracts) {
  const container = document.getElementById('groupsContainer')
  if (!container) return

  const doneWasOpen = document.getElementById('doneToggle')?.getAttribute('aria-expanded') === 'true'
  const filter = _activeFilter()

  const needsYou = contracts.filter(_isNeedsYou)
  const nyIds = new Set(needsYou.map(c => c.id))
  const waiting = contracts.filter(c => !nyIds.has(c.id) && !_isDone(c))
  const doneGroup = contracts.filter(_isDone)

  let html = ''

  if (needsYou.length > 0) {
    html += `<section class="db-group" id="group-needs-you">
      <div class="db-group__header">
        <span class="db-group__label">NEEDS YOU</span>
        <span class="db-group__count">${needsYou.length}</span>
      </div>
      <div class="db-cards">${needsYou.map(_buildCard).join('')}</div>
    </section>`
  }

  if (waiting.length > 0) {
    html += `<section class="db-group" id="group-waiting">
      <div class="db-group__header">
        <span class="db-group__label">WAITING ON OTHERS</span>
        <span class="db-group__count">${waiting.length}</span>
      </div>
      <div class="db-rows">${waiting.map(c => _buildRow(c, false)).join('')}</div>
    </section>`
  }

  if (doneGroup.length > 0) {
    const expanded = doneWasOpen
    html += `<section class="db-group" id="group-done">
      <button class="db-group__header db-group__toggle" id="doneToggle" aria-expanded="${expanded}">
        <span class="db-group__label">DONE</span>
        <span class="db-group__count">${doneGroup.length}</span>
        <span class="db-group__chevron" aria-hidden="true">▸</span>
      </button>
      <div class="db-rows" id="doneRows"${expanded ? '' : ' hidden'}>${doneGroup.map(c => _buildRow(c, true)).join('')}</div>
    </section>`
  }

  container.innerHTML = html

  if (filter !== 'all') _applyFilter(filter)
  _wireDoneToggle()
}

// ── Done group toggle ─────────────────────────────────────────────────────
function _wireDoneToggle() {
  const btn = document.getElementById('doneToggle')
  const rows = document.getElementById('doneRows')
  if (!btn || !rows) return
  btn.addEventListener('click', () => {
    const expanded = btn.getAttribute('aria-expanded') === 'true'
    btn.setAttribute('aria-expanded', String(!expanded))
    rows.hidden = expanded
  })
}
_wireDoneToggle()

// ── Project filter ────────────────────────────────────────────────────────
function _applyFilter(filterId) {
  document.querySelectorAll('[data-project]').forEach(el => {
    el.hidden = filterId !== 'all' && el.dataset.project !== filterId
  })
  // Hide groups that become empty under the filter
  document.querySelectorAll('.db-group').forEach(group => {
    const items = group.querySelectorAll('[data-project]')
    if (items.length === 0) return
    const anyVisible = filterId === 'all' || Array.from(items).some(el => el.dataset.project === filterId)
    group.hidden = !anyVisible
  })
}

const filterBtn = document.getElementById('filterBtn')
const filterMenu = document.getElementById('filterMenu')

filterBtn?.addEventListener('click', e => {
  e.stopPropagation()
  const open = filterMenu?.hidden === false
  if (filterMenu) filterMenu.hidden = open
  filterBtn.setAttribute('aria-expanded', String(!open))
})

filterMenu?.addEventListener('click', e => {
  const opt = e.target.closest('[data-filter]')
  if (!opt) return
  const filterId = opt.dataset.filter
  filterMenu.querySelectorAll('.db-filter__opt').forEach(o => o.classList.remove('db-filter__opt--active'))
  opt.classList.add('db-filter__opt--active')
  const label = filterId === 'all' ? 'All projects' : opt.textContent.trim()
  if (filterBtn) filterBtn.firstChild.textContent = label + ' '
  filterMenu.hidden = true
  filterBtn?.setAttribute('aria-expanded', 'false')
  _applyFilter(filterId)
})

document.addEventListener('click', e => {
  if (!document.getElementById('projectFilter')?.contains(e.target)) {
    if (filterMenu) filterMenu.hidden = true
    filterBtn?.setAttribute('aria-expanded', 'false')
  }
})

// ── New project modal ──────────────────────────────────────────────────────
const modal   = document.getElementById('projModal')
const form    = document.getElementById('projForm')
const projErr = document.getElementById('projErr')
const openModal  = () => { if (modal) modal.hidden = false }
const closeModal = () => { if (modal) modal.hidden = true }

document.getElementById('newProjFromFilter')?.addEventListener('click', openModal)
document.getElementById('projCancel')?.addEventListener('click', closeModal)
modal?.addEventListener('click', e => { if (e.target === modal) closeModal() })
form?.addEventListener('submit', async e => {
  e.preventDefault()
  const name = document.getElementById('projName')?.value?.trim()
  const desc = document.getElementById('projDesc')?.value?.trim()
  if (!name) return
  const btn = form.querySelector('[type=submit]')
  if (btn) { btn.disabled = true; btn.textContent = 'Creating…' }
  try {
    const res = await fetch(`${apiUrl}/api/projects`, {
      method: 'POST', credentials: 'include',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name, description: desc || null }),
    })
    if (res.ok) { location.reload() }
    else {
      const d = await res.json().catch(() => ({}))
      if (projErr) projErr.textContent = d.error ?? 'Failed'
      if (btn) { btn.disabled = false; btn.textContent = 'Create' }
    }
  } catch {
    if (projErr) projErr.textContent = 'Network error'
    if (btn) { btn.disabled = false; btn.textContent = 'Create' }
  }
})

// ── SSE — targeted card update (no full page reload) ──────────────────────
try {
  const es = new EventSource(`${apiUrl}/api/events`, { withCredentials: true })
  es.onmessage = async () => {
    try {
      const res = await fetch(`${apiUrl}/api/contracts`, { credentials: 'include' })
      if (!res.ok) return
      const { contracts } = await res.json()

      // Check if anything actually changed before touching the DOM
      const changed =
        contracts.length !== currentContracts.length ||
        contracts.some(nc => {
          const old = currentContracts.find(oc => oc.id === nc.id)
          return !old || old.status !== nc.status || old.updatedAt !== nc.updatedAt
        })

      if (!changed) return
      currentContracts = contracts
      _renderGroups(contracts)
    } catch {}
  }
  es.onerror = () => es.close()
} catch {}
</script>
