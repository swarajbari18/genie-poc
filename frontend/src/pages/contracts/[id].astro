  .thread-bubble__attachments {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.625rem;
  }

  /* Attachment chip */
  .attachment-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
