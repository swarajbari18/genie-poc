</style>

<script define:vars={{ apiUrl, contractId: id! }}>
  // ── Stage mapping (mirrors SSR function) ──────────────────────────────────
  function getStage(status) {
    if (status === 'draft') return 1
    if (['sent', 'ai_processing'].includes(status)) return 2
    if (['received', 'replied', 'negotiating'].includes(status)) return 3
    if (['out_for_signature', 'partially_signed'].includes(status)) return 4
    if (['completed', 'signed'].includes(status)) return 5
    if (status === 'declined') return 3
    return 1
  }

  // ── Send-for-Review card ──────────────────────────────────────────────────
  (function initSendCard() {
    const card = document.getElementById('sendCard');
    if (!card) return;
    const expandBtn      = document.getElementById('sendExpandBtn');
    const collapseBtn    = document.getElementById('sendCollapseBtn');
    const cancelBtn      = document.getElementById('sendCancelBtn');
    const recipientRows  = document.getElementById('recipientRows');
    const addRecipientBtn = document.getElementById('addRecipientBtn');
    const previewName    = document.getElementById('sendPreviewName');

    const setExpanded = (open) => {
      card.setAttribute('data-expanded', open ? 'true' : 'false');
      if (open) {
        const firstEmail = recipientRows?.querySelector('input[name="recipientEmail[]"]');
        if (firstEmail) firstEmail.focus();
      }
    };
    if (expandBtn)   expandBtn.addEventListener('click', () => setExpanded(true));
    if (collapseBtn) collapseBtn.addEventListener('click', () => setExpanded(false));
    if (cancelBtn)   cancelBtn.addEventListener('click', () => setExpanded(false));

    function refreshRecipientRemovers() {
      if (!recipientRows) return;
      const cards = recipientRows.querySelectorAll('.signer-card');
      cards.forEach((c, idx) => {
        const btn = c.querySelector('.signer-card__remove');
        if (btn) btn.hidden = !(cards.length > 1 && idx > 0);
      });
    }

    function wireRecipientRemove(btn) {
      if (!btn || btn.dataset.wired === '1') return;
      btn.dataset.wired = '1';
      btn.addEventListener('click', () => {
        btn.closest('.signer-card')?.remove();
        refreshRecipientRemovers();
        updatePreviewName();
        if (addRecipientBtn) addRecipientBtn.style.display = '';
      });
    }

    function updatePreviewName() {
      const firstNameInput = recipientRows?.querySelector('input[name="recipientName[]"]');
      if (previewName) previewName.textContent = firstNameInput?.value.trim() || 'there';
    }

    function recipientEmailExists(email) {
      if (!email) return false;
      const norm = email.trim().toLowerCase();
      return Array.from(recipientRows?.querySelectorAll('input[name="recipientEmail[]"]') ?? [])
        .some(i => i.value.trim().toLowerCase() === norm);
    }

    function findBlankRecipientCard() {
      return Array.from(recipientRows?.querySelectorAll('.signer-card') ?? []).find(c => {
        const nameEl  = c.querySelector('input[name="recipientName[]"]');
        const emailEl = c.querySelector('input[name="recipientEmail[]"]');
        return !nameEl?.value.trim() && !emailEl?.value.trim();
      });
    }

    // Live preview: first name input → "Hi <name>,"
    recipientRows?.addEventListener('input', (e) => {
      if (e.target.name === 'recipientName[]') updatePreviewName();
    });

    // Wire existing remove buttons
    recipientRows?.querySelectorAll('.signer-card__remove').forEach(wireRecipientRemove);
    refreshRecipientRemovers();

    // Add recipient row
    addRecipientBtn?.addEventListener('click', () => {
      if (!recipientRows) return;
      if (recipientRows.children.length >= 10) return;
      const clone = recipientRows.children[0].cloneNode(true);
      clone.querySelectorAll('input').forEach(i => i.value = '');
      const removeBtn = clone.querySelector('.signer-card__remove');
      if (removeBtn) { removeBtn.removeAttribute('data-wired'); wireRecipientRemove(removeBtn); }
      recipientRows.appendChild(clone);
      refreshRecipientRemovers();
      if (recipientRows.children.length >= 10) addRecipientBtn.style.display = 'none';
      clone.querySelector('input[name="recipientEmail[]"]')?.focus();
    });

    // Person chips fill first empty row (or add a new one)
    document.querySelectorAll('[data-fill-recipient]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const name  = btn.dataset.personName  || '';
        const email = btn.dataset.personEmail || '';
        if (!email || recipientEmailExists(email)) return;
        const blank = findBlankRecipientCard();
        if (blank) {
          blank.querySelector('input[name="recipientName[]"]').value  = name;
          blank.querySelector('input[name="recipientEmail[]"]').value = email;
        } else if (recipientRows && recipientRows.children.length < 10) {
          addRecipientBtn?.click();
          const last = recipientRows.lastElementChild;
          if (last) {
            last.querySelector('input[name="recipientName[]"]').value  = name;
            last.querySelector('input[name="recipientEmail[]"]').value = email;
          }
        }
        updatePreviewName();
      });
    });
  })();

  // ── Sign Now is wired up in a separate (Vite-bundled) <script> block below
  //    because it needs to `import` the hellosign-embedded SDK, which is not
  //    allowed inside this inline `define:vars` script.

  // ── Download Signed PDF ────────────────────────────────────────────────────
  async function fetchAndOpenSignedDoc() {
    const res = await fetch(`${apiUrl}/api/contracts/${contractId}/signed-document`, {
      credentials: 'include',
    });
    if (res.ok) {
      const { url } = await res.json();
      window.open(url, '_blank');
    }
  }

  const downloadSignedBtn = document.getElementById('downloadSignedBtn');
  if (downloadSignedBtn) downloadSignedBtn.addEventListener('click', fetchAndOpenSignedDoc);

  const nextActionSignBtn = document.getElementById('nextActionSignBtn');
  const signNowBtnAlt = document.getElementById('signNowBtn');
  if (nextActionSignBtn && signNowBtnAlt) {
    nextActionSignBtn.addEventListener('click', () => signNowBtnAlt.click());
  }

  // ── Send for Review ────────────────────────────────────────────────────────
  const sendForm = document.getElementById('sendForm');
  if (sendForm) {
    sendForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('sendBtn');
      btn.disabled = true;
      btn.textContent = 'Sending...';
      const sendError = document.getElementById('sendError');
      if (sendError) { sendError.textContent = ''; sendError.style.display = 'none'; }

      const names  = Array.from(sendForm.querySelectorAll('input[name="recipientName[]"]')).map(i => i.value.trim());
      const emails = Array.from(sendForm.querySelectorAll('input[name="recipientEmail[]"]')).map(i => i.value.trim());

      // Validate
      for (let i = 0; i < emails.length; i++) {
        if (!emails[i]) {
          if (sendError) { sendError.textContent = 'Please enter an email for every recipient.'; sendError.style.display = 'block'; }
          btn.disabled = false; btn.textContent = 'Send'; return;
        }
        if (!/.+@.+\..+/.test(emails[i])) {
          if (sendError) { sendError.textContent = `"${emails[i]}" doesn't look like a valid email.`; sendError.style.display = 'block'; }
          btn.disabled = false; btn.textContent = 'Send'; return;
        }
      }

      const recipients = emails.map((email, i) => ({ name: names[i] || email, email }));

      const res = await fetch(`${apiUrl}/api/contracts/${contractId}/send`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ recipients }),
        credentials: 'include',
      });

      if (res.ok) {
        window.location.reload();
      } else {
        const err = await res.json().catch(() => ({}));
        if (sendError) { sendError.textContent = err.error || 'Failed to send'; sendError.style.display = 'block'; }
        btn.disabled = false;
        btn.textContent = 'Send';
      }
    });
  }

  // ── Attachment downloads ───────────────────────────────────────────────────
  // Both .attachment (legacy AI footer) and .attachment-chip (thread bubbles)
  document.querySelectorAll('.attachment, .attachment-chip').forEach(el => {
    el.addEventListener('click', async (e) => {
      e.preventDefault();
      const attachmentError = document.getElementById('attachmentError');
      if (attachmentError) { attachmentError.textContent = ''; attachmentError.style.display = 'none'; }
      const key = el.getAttribute('data-key');
      const url = key
        ? `${apiUrl}/api/contracts/${contractId}/attachment?key=${encodeURIComponent(key)}`
        : `${apiUrl}/api/contracts/${contractId}/download-url`;
      const res = await fetch(url, { credentials: 'include' });
      if (res.ok) {
        const { url: signedUrl } = await res.json();
        window.open(signedUrl, '_blank');
      } else {
        if (attachmentError) { attachmentError.textContent = 'Failed to get download link'; attachmentError.style.display = 'block'; }
      }
    });
  });

  // ── SSE — Smart Reload ─────────────────────────────────────────────────────
  function initSSE() {
    const mainEl = document.querySelector('[data-current-status]');
    const currentStatus = mainEl ? mainEl.getAttribute('data-current-status') : null;

    const es = new EventSource(`${apiUrl}/api/events`, { withCredentials: true });

    es.addEventListener('status', (e) => {
      const data = JSON.parse(e.data);
      if (data.contractId !== contractId) return;
      if (!['draft', 'sent', 'ai_processing', 'received', 'replied', 'negotiating', 'out_for_signature', 'partially_signed', 'completed', 'signed', 'declined'].includes(data.status)) {
        return;
      }

      const currentStage = getStage(currentStatus ?? '');
      const newStage     = getStage(data.status);

      if (newStage !== currentStage) {
        // Stage changed — action area content changes; full reload needed
        window.location.reload();
        return;
      }

      // If in signing stage (4), always reload to refresh signer status badges
      if (newStage === 4) {
        window.location.reload();
        return;
      }

      // Same stage, not signing — no DOM change needed; just keep our local
      // "currentStatus" attribute in sync so the next event's stage diff is
      // computed against the latest status.
      if (mainEl) mainEl.setAttribute('data-current-status', data.status);
    });

    es.onerror = (err) => {
      console.error('SSE error', err);
    };
  }

  initSSE();
</script>

<script>
  // BoldSign embedded signing: open the sign URL in a full-screen iframe overlay
  // and listen for postMessage events from app.boldsign.com to detect completion.

  const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';
  const contractId = window.location.pathname.split('/').filter(Boolean).pop();

  const signNowBtn = document.getElementById('signNowBtn') as HTMLButtonElement | null;
  const signNowError = document.getElementById('signNowError') as HTMLElement | null;

  function showError(msg: string) {
    if (signNowError) {
      signNowError.textContent = msg;
      signNowError.style.display = 'block';
    }
  }

  function resetButton() {
    if (signNowBtn) {
      signNowBtn.disabled = false;
      signNowBtn.textContent = 'Sign Now';
    }
  }

  function buildOverlay(signUrl: string): { overlay: HTMLElement; close: () => void } {
    const overlay = document.createElement('div');
    overlay.style.cssText = [
      'position:fixed',
      'inset:0',
      'background:rgba(0,0,0,0.75)',
      'z-index:9999',
      'display:flex',
      'align-items:center',
      'justify-content:center',
      'padding:24px',
    ].join(';');

    const frameWrap = document.createElement('div');
    frameWrap.style.cssText = [
      'position:relative',
      'width:100%',
      'height:100%',
      'max-width:1200px',
      'background:#fff',
      'border-radius:12px',
      'overflow:hidden',
      'box-shadow:0 24px 64px rgba(0,0,0,0.4)',
    ].join(';');

    const closeBtn = document.createElement('button');
    closeBtn.type = 'button';
    closeBtn.textContent = '×';
    closeBtn.setAttribute('aria-label', 'Close signing window');
    closeBtn.style.cssText = [
      'position:absolute',
      'top:8px',
      'right:12px',
      'z-index:1',
      'background:rgba(255,255,255,0.95)',
      'border:1px solid #ddd',
      'border-radius:50%',
      'width:32px',
      'height:32px',
      'font-size:20px',
      'line-height:1',
      'cursor:pointer',
    ].join(';');

    const iframe = document.createElement('iframe');
    iframe.src = signUrl;
    iframe.allow = 'camera; microphone; geolocation';
    iframe.style.cssText = 'width:100%;height:100%;border:0;display:block;';

    frameWrap.appendChild(closeBtn);
    frameWrap.appendChild(iframe);
    overlay.appendChild(frameWrap);
    document.body.appendChild(overlay);

    const close = () => {
      if (overlay.parentNode) overlay.parentNode.removeChild(overlay);
    };
    closeBtn.addEventListener('click', close);

    return { overlay, close };
  }

  // BoldSign signLinks are served from app.boldsign.com (EU: app-eu.boldsign.com).
  // Accept either origin.
  const BOLDSIGN_ORIGINS = new Set([
    'https://app.boldsign.com',
    'https://app-eu.boldsign.com',
  ]);

  if (signNowBtn) {
    signNowBtn.addEventListener('click', async () => {
      signNowBtn.disabled = true;
      signNowBtn.textContent = 'Loading signing page…';
      if (signNowError) { signNowError.textContent = ''; signNowError.style.display = 'none'; }

      let payload: { url: string };
      try {
        const res = await fetch(`${apiUrl}/api/contracts/${contractId}/sign-url`, {
          credentials: 'include',
        });
        if (!res.ok) throw new Error(`status ${res.status}`);
        payload = await res.json();
      } catch (err) {
        console.error('[SignNow] failed to fetch sign URL', err);
        showError('Failed to load signing page. Please try again.');
        resetButton();
        return;
      }

      const { close } = buildOverlay(payload.url);

      const onMessage = (evt: MessageEvent) => {
        if (!BOLDSIGN_ORIGINS.has(evt.origin)) return;
        // BoldSign posts { type, ... } messages. The exact payload type names
        // observed in the wild: onSignComplete, onSignCancel, onSignDecline,
        // onSignError, onReassign, onSendComplete. Some installs also emit a
        // bare string. Be lenient.
        const data: any = evt.data;
        const type = typeof data === 'string' ? data : data?.type ?? data?.eventType;
        if (!type) return;
        const t = String(type).toLowerCase();
        if (t.includes('signcomplete') || t === 'onsigncomplete') {
          window.removeEventListener('message', onMessage);
          close();
          // Webhook will mark the signer as signed; reload to reflect new state.
          window.location.reload();
        } else if (t.includes('cancel') || t.includes('decline')) {
          window.removeEventListener('message', onMessage);
          close();
          resetButton();
        } else if (t.includes('error')) {
          console.error('[SignNow] BoldSign error', data);
          window.removeEventListener('message', onMessage);
          close();
          showError('Signing failed. Please try again.');
          resetButton();
        }
      };
      window.addEventListener('message', onMessage);
    });
  }

  // ── Sender prepare-iframe (Send for Signature → drag fields → click Send) ──
  // Triggered by a custom event dispatched from the inline `signForm` submit
  // handler. The sender places signature/date fields on the PDF inside the
  // iframe, then clicks Send in the BoldSign toolbar. BoldSign creates the
  // signature request and fires the Sent webhook to our backend; we reload
  // the page to reflect the new 'out_for_signature' state.
  window.addEventListener('genie:open-prepare-iframe', (evt: Event) => {
    const detail = (evt as CustomEvent<{ sendUrl: string }>).detail;
    if (!detail?.sendUrl) return;

    const { close } = buildOverlay(detail.sendUrl);

    const onPrepareMessage = (evt: MessageEvent) => {
      if (!BOLDSIGN_ORIGINS.has(evt.origin)) return;
      const data: any = evt.data;
      const type = typeof data === 'string' ? data : data?.type ?? data?.eventType;
      if (!type) return;
      const t = String(type).toLowerCase();
      if (
        t.includes('documentsent') ||
        t === 'ondocumentsent' ||
        t.includes('sendcomplete') ||
        t === 'onsendcomplete' ||
        t.includes('draftsuccess')
      ) {
        window.removeEventListener('message', onPrepareMessage);
        close();
        // Webhook will create signer rows + flip contract status; reload.
        window.location.reload();
      } else if (t.includes('cancel') || t.includes('close')) {
        window.removeEventListener('message', onPrepareMessage);
        close();
      } else if (t.includes('error') || t.includes('failed')) {
        console.error('[Prepare] BoldSign error', data);
        window.removeEventListener('message', onPrepareMessage);
        close();
        alert('Failed to prepare the document. Please try again.');
      }
    };
    window.addEventListener('message', onPrepareMessage);
  });
</script>
