  /* ── Signing wizard ────────────────────────────────────────────────────── */
  .wizard-step { display: flex; flex-direction: column; gap: 0.875rem; }

  .wizard-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
