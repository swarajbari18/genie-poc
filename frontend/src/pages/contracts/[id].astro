  /* Thread row — wrapper that places avatar next to bubble */
  .thread-row {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    max-width: 100%;
  }

  .thread-row--outbound {
    justify-content: flex-end;
    margin-left: auto;
  }

  .thread-row--inbound {
    justify-content: flex-start;
    margin-right: auto;
  }

  .thread-stack {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    max-width: 85%;
    min-width: 0;
