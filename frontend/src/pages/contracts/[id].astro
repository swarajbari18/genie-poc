---
import AppLayout from '../../layouts/AppLayout.astro'
import DiffViewer from '../../components/DiffViewer.tsx'
import ContractDocViewer from '../../components/contracts/ContractDocViewer.astro'
import ContractSigningWizard from '../../components/contracts/ContractSigningWizard.astro'
import ContractThread from '../../components/contracts/ContractThread.astro'

const { id } = Astro.params
const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080'
const cookieHeader = Astro.request.headers.get('cookie') ?? ''

let currentUserId: string | null = null
let user: any = null
try {
  const sessionRes = await fetch(`${apiUrl}/api/auth/get-session`, {
    headers: { cookie: cookieHeader },
  })
  if (!sessionRes.ok) return Astro.redirect('/')
  const session = await sessionRes.json()
  if (!session?.user) return Astro.redirect('/')
  currentUserId = session.user.id
  user = session.user
} catch {
  return Astro.redirect('/?error=service_unavailable')
}

let contract: any
let threads: any[] = []
let signers: any[] = []
let versions: any[] = []
let documentUrl: string | null = null
let nextAction: string = 'none'
let contacts: any[] = []

try {
  const res = await fetch(`${apiUrl}/api/contracts/${id}`, {
    headers: { cookie: cookieHeader },
  })
  if (!res.ok) return Astro.redirect('/dashboard')
  const body = await res.json()
  contract = body.contract
  threads = body.threads ?? []
  signers = body.signers ?? []
  versions = body.versions ?? []
  documentUrl = body.documentUrl ?? null
  nextAction = body.nextAction ?? 'none'
} catch {
  return Astro.redirect('/dashboard')
}

try {
  const contactsRes = await fetch(`${apiUrl}/api/contacts`, {
    headers: { cookie: cookieHeader },
  })
  if (contactsRes.ok) {
    const body = await contactsRes.json()
    contacts = body.contacts ?? []
  }
} catch {
  contacts = []
}

// HTML editing — only for AI-generated drafts that have htmlContent stored
const v1Version = versions.find((v: any) => v.versionNumber === 1 && v.authoredBy === 'owner')
const v1HtmlContent: string | null = v1Version?.htmlContent ?? null
const showEditTab = contract.status === 'draft' && !!v1HtmlContent

// If v1 (owner) and v2+ (counterparty) both exist, show the version diff
const ownerVersion = versions.find((v: any) => v.versionNumber === 1)
const latestCounterpartyVersion = [...versions]
  .filter((v: any) => v.authoredBy === 'counterparty')
  .sort((a: any, b: any) => b.versionNumber - a.versionNumber)[0] ?? null
const showVersionDiff = !!(ownerVersion && latestCounterpartyVersion)

// ── Stage mapping (SSR) ──────────────────────────────────────────────────────
function getStage(status: string): number {
  if (status === 'draft') return 1
  if (['sent', 'ai_processing'].includes(status)) return 2
  if (['received', 'replied', 'negotiating'].includes(status)) return 3
  if (['out_for_signature', 'partially_signed'].includes(status)) return 4
  if (['completed', 'signed'].includes(status)) return 5
  if (status === 'declined') return 3
  return 1
}

const STAGES = [
  { num: 1, label: 'Draft' },
  { num: 2, label: 'Sent' },
  { num: 3, label: 'Under Review' },
  { num: 4, label: 'Signing' },
  { num: 5, label: 'Executed' },
]

const currentStage = getStage(contract.status)
const isDeclined = contract.status === 'declined'

// ── Condition helpers ────────────────────────────────────────────────────────
const showSendForm    = contract.status === 'draft'
const showAwaitingCard = ['sent', 'ai_processing'].includes(contract.status)
const counterpartyFirstName = contract.recipientName?.split(' ')[0] ?? 'them'
const remainingSigners = signers.filter((s: any) => s.status !== 'signed').length

const showAISpinner   = contract.status === 'ai_processing'
const showUnderReview = ['received', 'replied', 'negotiating'].includes(contract.status)
const showSigningRoster = ['out_for_signature', 'partially_signed'].includes(contract.status)
const showSigningForm = ['replied', 'negotiating'].includes(contract.status) && contract.origin !== 'received'
const showCompleted   = ['completed', 'signed'].includes(contract.status)
const showDeclined    = contract.status === 'declined'

const showReplyComposer =
  ['replied', 'negotiating'].includes(contract.status) ||
  (contract.origin === 'received' && ['received', 'replied', 'negotiating'].includes(contract.status))

const mySignerRow = signers.find(
  (s: any) => s.genieUserId === currentUserId && ['pending', 'sent', 'viewed'].includes(s.status)
)

type SuggestedPerson = {
  key: string
  label: string
  name: string
  email: string
  role: 'creator' | 'counterparty' | 'other'
}

const suggestedPeople: SuggestedPerson[] = []
const seenPeople = new Set<string>()
function addSuggestedPerson(person: Omit<SuggestedPerson, 'key'>) {
  const email = person.email?.trim()
  if (!email) {
    return
  }
  const key = email.toLowerCase()
  if (seenPeople.has(key)) {
    return
  }
  seenPeople.add(key)
  suggestedPeople.push({ ...person, key })
}

addSuggestedPerson({
  label: 'Me',
  name: user?.name || user?.email || 'Me',
  email: user?.email || '',
  role: 'creator',
})
// A3: use identity email (real Google address) over relay address for display + signer defaults
const counterpartyEmail = contract.recipientIdentityEmail ?? contract.recipientEmail ?? ''
addSuggestedPerson({
  label: 'Counterparty',
  name: contract.recipientName || counterpartyEmail,
  email: counterpartyEmail,
  role: 'counterparty',
})
contacts.forEach((contact) => {
  addSuggestedPerson({
    label: contact.name || contact.email,
    name: contact.name || contact.email,
    email: contact.email,
    role: 'other',
  })
})

const reviewSuggestions = suggestedPeople.filter((p) => p.role !== 'creator').slice(0, 6)
const signingSuggestions = suggestedPeople.slice(0, 8)
const initialSignerRows = signingSuggestions.filter((p) => p.role === 'creator' || p.role === 'counterparty').slice(0, 2)
if (initialSignerRows.length === 0) {
  initialSignerRows.push({ key: 'blank', label: '', name: '', email: '', role: 'counterparty' })
}

// ── Signer display data (computed here to avoid TS generics in JSX) ──────────
const signerLabelMap: Record<string, string> = {
  pending:  'Pending',
  sent:     'Waiting…',
  viewed:   'Viewed',
  signed:   'Signed ✓',
  declined: 'Declined ✗',
}
const signerBadgeClassMap: Record<string, string> = {
  signed:   'signer-badge--signed',
  declined: 'signer-badge--declined',
  viewed:   'signer-badge--viewed',
}
const signersDisplay = signers.map((s: any) => ({
  id:         s.id,
  signerName: s.signerName,
  signerEmail: s.signerEmail,
  status:     s.status,
  label:      signerLabelMap[s.status] ?? s.status,
  badgeClass: signerBadgeClassMap[s.status] ?? 'badge-muted',
}))

// Format date helper
function fmtDate(iso: string): string {
  if (!iso) return ''
  try {
    return new Date(iso).toLocaleString('en-US', {
      month: 'short', day: 'numeric', year: 'numeric',
      hour: 'numeric', minute: '2-digit'
    })
  } catch {
    return iso
  }
}

// Short date for thread bubble timestamps: "Jan 3 · 2:45 PM"
function fmtShortDate(iso: string): string {
  if (!iso) return ''
  try {
    const d = new Date(iso)
    const date = d.toLocaleString('en-US', { month: 'short', day: 'numeric' })
    const time = d.toLocaleString('en-US', { hour: 'numeric', minute: '2-digit' })
    return `${date} · ${time}`
  } catch {
    return iso
  }
}

// First initial helper for avatar circles
function firstInitial(...candidates: Array<string | undefined | null>): string {
  for (const c of candidates) {
    if (c && typeof c === 'string' && c.trim().length > 0) {
      return c.trim()[0].toUpperCase()
    }
  }
  return '?'
}

const userInitial = firstInitial(user?.name, user?.email)
---
<AppLayout title={`${contract.title} — Genie AI`} user={user} apiUrl={apiUrl}>
  <main class="contract-main" data-current-status={contract.status} data-contract-id={id}>

    <p id="attachmentError" class="error-banner" aria-live="polite"></p>

    {/* ── Header ────────────────────────────────────────────────────────────── */}
    <div class="page-header">
      <a href="/dashboard" class="back-link">← All Contracts</a>

      <div class="page-header__row">
        <div class="page-header__lead">
          <h1 class="page-title">
            {contract.title}
            {contract.origin === 'received' && (
              <span class="badge badge-warning received-badge">RECEIVED</span>
            )}
          </h1>
          {(contract.recipientName || counterpartyEmail) && (
            <p class="page-header__counter">
              {contract.recipientName ? (
                <>
                  <span class="page-header__counter-name">{contract.recipientName}</span>
                  {counterpartyEmail && <span class="page-header__counter-dot"> · </span>}
                  {counterpartyEmail && <span class="page-header__counter-email">{counterpartyEmail}</span>}
                </>
              ) : (
                <span class="page-header__counter-email">{counterpartyEmail}</span>
              )}
            </p>
          )}
        </div>

        {/* Stage Indicator Strip — right side on desktop, below title on mobile */}
        <div class={`stage-strip${showCompleted ? ' stage-strip--signed' : ''}`} role="list" aria-label="Contract stages">
          {STAGES.map((stage) => {
            const isCompleted = currentStage > stage.num
            const isActive    = currentStage === stage.num
            const isDeclinedStage = isDeclined && stage.num === 3

            let circleClass = 'stage-circle'
            if (isDeclinedStage) circleClass += ' stage-circle--declined'
            else if (isCompleted) circleClass += ' stage-circle--completed'
            else if (isActive)    circleClass += ' stage-circle--active'
            else                  circleClass += ' stage-circle--future'

            let labelClass = 'stage-label'
            if (isDeclinedStage) labelClass += ' stage-label--declined'
            else if (isActive)   labelClass += ' stage-label--active'

            return (
              <div class="stage-item" role="listitem">
                {stage.num > 1 && (
                  <div class={`stage-connector ${isCompleted || isActive ? 'stage-connector--filled' : ''}`} />
                )}
                <div class={circleClass}>
                  {isCompleted && !isDeclined ? '✓' : String(stage.num)}
                </div>
                <span class={labelClass}>{stage.label}</span>
              </div>
            )
          })}
        </div>
      </div>
    </div>

    {/* ── Two-Column Body ───────────────────────────────────────────────────── */}
    <div class="contract-body">

      {/* ── LEFT COLUMN — Document / Actions ────────────────────────────────── */}
      <div class="col-left">

        {/* ── Next-action hint — one quiet line, no card ───────────────────── */}
        {nextAction !== 'none' && nextAction !== 'executed' && (
          <div class={`next-action-hint next-action-hint--${nextAction === 'awaiting_their_reply' || nextAction === 'awaiting_them_sign' ? 'muted' : 'active'}`}>
            <span class="next-action-hint__text">
              {nextAction === 'awaiting_your_review' && `Your turn — review the proposed changes.`}
              {nextAction === 'awaiting_their_reply' && `Waiting on ${counterpartyFirstName} to reply.`}
              {nextAction === 'ready_to_send_signature' && `Review complete — ready to send for signature.`}
              {nextAction === 'awaiting_you_sign' && `Your turn — sign to execute.`}
              {nextAction === 'awaiting_them_sign' && `Waiting on ${remainingSigners === 1 ? '1 person' : `${remainingSigners} people`} to sign.`}
              {nextAction === 'declined' && `${counterpartyFirstName} declined.`}
            </span>
            {nextAction === 'awaiting_your_review' && (
              <a href="#threadSection" class="next-action-hint__cta">Review →</a>
            )}
            {nextAction === 'ready_to_send_signature' && (
              <a href="#signingSection" class="next-action-hint__cta">Sign →</a>
            )}
            {nextAction === 'awaiting_you_sign' && (
              <button id="nextActionSignBtn" class="next-action-hint__cta">Sign now →</button>
            )}
            {nextAction === 'declined' && (
              <a href="#replySection" class="next-action-hint__cta">Reply →</a>
            )}
          </div>
        )}

        {/* ── Document viewer — always visible ─────────────────────── */}
        <ContractDocViewer
          documentUrl={documentUrl}
          contract={contract}
          showEditTab={showEditTab}
          v1HtmlContent={v1HtmlContent}
          showVersionDiff={showVersionDiff}
          ownerVersion={ownerVersion}
          latestCounterpartyVersion={latestCounterpartyVersion}
          showCompleted={showCompleted}
          apiUrl={apiUrl}
          contractId={id!}
        />

        {/* DRAFT — unified Send surface */}
        {showSendForm && (
          <section class="send-card card" id="sendCard" data-expanded="false">
            {/* Collapsed view */}
            <div class="send-card__collapsed">
              <div class="send-card__icon" aria-hidden="true">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M3 7l9 6 9-6" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                  <path d="M3 7v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V7" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                  <path d="M3 7l9-4 9 4" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                </svg>
              </div>
              <div class="send-card__copy">
                <h2 class="send-card__heading">Send</h2>
                <p class="send-card__body">Choose who should receive this contract. Genie keeps the next step simple.</p>
              </div>
              <button type="button" id="sendExpandBtn" class="btn-primary send-card__cta">Send</button>
            </div>

            {/* Expanded composer */}
            <div class="send-card__expanded">
              <div class="send-card__expanded-head">
                <h2 class="send-card__heading">Send</h2>
                <button type="button" id="sendCollapseBtn" class="send-card__collapse" aria-label="Collapse">Collapse ↑</button>
              </div>
              <form id="sendForm" class="send-form">
                <label class="form-label">To</label>

                <div id="recipientRows" class="signer-cards">
                  <div class="signer-card">
                    <div class="signer-card__row">
                      <input type="text"  name="recipientName[]"  placeholder="Name"            class="form-input" autocomplete="off" />
                      <input type="email" name="recipientEmail[]" placeholder="name@company.com" class="form-input" autocomplete="off" required />
                    </div>
                    <button type="button" class="signer-card__remove" aria-label="Remove recipient" hidden>×</button>
                  </div>
                </div>

                {reviewSuggestions.length > 0 && (
                  <div class="people-strip" aria-label="Suggested recipients">
                    {reviewSuggestions.map((person) => (
                      <button
                        type="button"
                        class="person-chip"
                        data-fill-recipient
                        data-person-name={person.name}
                        data-person-email={person.email}
                      >
                        <span class="person-chip__label">{person.label}</span>
                        <span class="person-chip__email">{person.email}</span>
                      </button>
                    ))}
                  </div>
                )}

                <button type="button" id="addRecipientBtn" class="add-signer-btn">+ Add another recipient</button>

                <div class="send-preview" aria-label="Email preview">
                  <div class="send-preview__head">
                    Subject: <span class="send-preview__subj">{contract.title} — Review Requested</span>
                  </div>
                  <div class="send-preview__body">
                    Hi <span id="sendPreviewName" class="send-preview__var">there</span>,
                    {'\n\n'}
                    {(user?.name ?? user?.email ?? 'A Genie user')} has sent you a contract to review via Genie AI.
                    {'\n\n'}
                    Contract: {contract.title}
                    {'\n\n'}
                    Please review the attached PDF and reply to this email with your feedback or a revised version.
                    {'\n\n'}
                    — Genie AI
                  </div>
                </div>

                <p id="sendError" class="error-banner"></p>
                <div class="send-form__actions">
                  <button type="submit" id="sendBtn" class="btn-primary">Send</button>
                  <button type="button" id="sendCancelBtn" class="btn-ghost">Cancel</button>
                </div>
              </form>
            </div>
          </section>
        )}

        {/* SENT / AI_PROCESSING — Awaiting Response */}
        {showAwaitingCard && (
          <>
            <section class="card awaiting-card">
              <div class="awaiting-card__icon" aria-hidden="true">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/>
                  <path d="M12 7v5l3 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              <div class="awaiting-card__copy">
                <h2 class="awaiting-card__heading">Awaiting {contract.recipientName || 'a reply'}'s reply</h2>
                <p class="awaiting-card__sub">
                  Sent to <span class="awaiting-card__email">{counterpartyEmail || contract.recipientEmail}</span>
                  {contract.sentAt && <> · {fmtDate(contract.sentAt)}</>}
                </p>
                <p class="card-subtext awaiting-card__hint">You'll be notified here when they respond. No action needed.</p>
              </div>
            </section>

            {showAISpinner && (
              <div class="ai-processing-pill" role="status">
                <div class="spinner"></div>
                <span>Analysing their changes…</span>
              </div>
            )}
          </>
        )}

        {/* UNDER REVIEW — Info card + optional AI analysis */}
        {showUnderReview && (
          <>
            {/* AI Analysis — text reply */}
            {contract.aiAnalysis?.type === 'text_reply' && (
              <section class="card ai-card">
                <div class="ai-card__header">
                  <div class="ai-card__title-row">
                    <span class="badge ai-badge">AI</span>
                    <h2 class="card-heading">
                      {contract.aiAnalysis.sentiment === 'accept' && 'They accepted'}
                      {contract.aiAnalysis.sentiment === 'reject' && 'They declined'}
                      {contract.aiAnalysis.sentiment === 'modify' && 'They want changes'}
                      {contract.aiAnalysis.sentiment === 'question' && 'They have a question'}
                    </h2>
                  </div>
                </div>

                {contract.aiAnalysis.summaryStatus === 'ok' ? (
                  <div class="ai-summary">{contract.aiAnalysis.summary}</div>
                ) : (
                  <p class="card-subtext">AI summary unavailable — read their reply in the thread.</p>
                )}

                {contract.aiAnalysis.changes?.length > 0 && (
                  <ul class="ai-changes-list">
                    {contract.aiAnalysis.changes.map((c: string) => (
                      <li class="ai-changes-list__item">{c}</li>
                    ))}
                  </ul>
                )}
              </section>
            )}

            {/* AI Analysis — PDF diff */}
            {contract.aiAnalysis && contract.aiAnalysis.type !== 'text_reply' && (
              <section class="card ai-card">
                <div class="ai-card__header">
                  <div class="ai-card__title-row">
                    <span class="badge ai-badge">AI</span>
                    <h2 class="card-heading">What changed</h2>
                  </div>
                  <div class="diff-stats">
                    <span class="diff-stat diff-stat--add">+{contract.aiAnalysis.stats.additions} added</span>
                    <span class="diff-stat diff-stat--del">-{contract.aiAnalysis.stats.deletions} removed</span>
                  </div>
                </div>

                {contract.aiAnalysis.summaryStatus === 'ok' ? (
                  <div class="ai-summary">{contract.aiAnalysis.summary}</div>
                ) : (
                  <p class="card-subtext">
                    {contract.aiAnalysis.summaryStatus === 'failed'
                      ? 'Plain-English summary unavailable — see the diff below.'
                      : 'AI summary disabled. See the diff below.'}
                  </p>
                )}

                <details class="diff-details">
                  <summary class="diff-summary">View full diff</summary>
                  <div class="diff-viewer-wrap">
                    <DiffViewer
                      oldText={contract.aiAnalysis.oldText}
                      newText={contract.aiAnalysis.newText}
                      client:visible
                    />
                  </div>
                </details>

                <div class="ai-card__footer">
                  <a href="#" class="attachment" data-key={contract.aiAnalysis.toStorageKey}>
                    📎 Download Their Version (PDF)
                  </a>
                </div>
              </section>
            )}

            {/* Signing confirm card */}
            {showSigningForm && (
              <ContractSigningWizard
                initialSignerRows={initialSignerRows}
                apiUrl={apiUrl}
                contractId={id!}
              />
            )}
          </>
        )}

        {/* SIGNING ROSTER — out_for_signature or partially_signed */}
        {showSigningRoster && (() => {
          const signedCount = signers.filter((s: any) => s.status === 'signed').length
          const totalCount  = signers.length || 1
          const pct = Math.round((signedCount / totalCount) * 100)
          return (
            <section class="card form-card">
              <div class="signing-progress">
                <div class="signing-progress__head">
                  <h2 class="card-heading" style="margin-bottom:0">Signature Request</h2>
                  <span class="signing-progress__count">{signedCount} of {totalCount} signatures collected</span>
                </div>
                <div class="progress-bar">
                  <div class="progress-bar__fill" style={`width:${pct}%`}></div>
                </div>
              </div>

              {signersDisplay.length > 0 && (
                <ul class="signer-timeline">
                  {signersDisplay.map((s) => (
                    <li class="signer-tl-item" data-signer-id={s.id} data-signer-status={s.status}>
                      <span class={`signer-tl-dot signer-tl-dot--${s.status}`} aria-hidden="true">
                        {s.status === 'signed' && '✓'}
                        {s.status === 'declined' && '×'}
                      </span>
                      <div class="signer-tl-body">
                        <div class="signer-name">{s.signerName}</div>
                        <div class="signer-email">{s.signerEmail}</div>
                      </div>
                      <span class="signer-tl-status">{s.label}</span>
                    </li>
                  ))}
                </ul>
              )}

              <p class="card-subtext signing-foot">Signers receive an email from Dropbox Sign with a link to sign.</p>
            </section>
          )
        })()}

        {/* DECLINED */}
        {showDeclined && (
          <section class="card status-card status-card--declined">
            <h2 class="declined-heading">Contract Declined</h2>
            <p class="card-subtext">The counterparty has declined this contract.</p>
          </section>
        )}

        {/* Sign Now — for logged-in Genie user who is a signer */}
        {mySignerRow && (
          <section class="card status-card status-card--accent">
            <h2 class="sign-now-heading">Your signature is required</h2>
            <p class="card-subtext">
              Click below to open the signing page. You will be redirected to Dropbox Sign.
            </p>
            <p id="signNowError" class="error-banner"></p>
            <button id="signNowBtn" class="btn-primary">Sign Now</button>
          </section>
        )}

      </div>{/* /col-left */}

      {/* ── RIGHT COLUMN — Activity / Thread ────────────────────────────────── */}
      <ContractThread
        threads={threads}
        showReplyComposer={showReplyComposer}
        user={user}
        userInitial={userInitial}
        apiUrl={apiUrl}
        contractId={id!}
        counterpartyName={contract.recipientName ?? undefined}
      />

    </div>{/* /contract-body */}
  </main>
</AppLayout>

<style is:global>
  /* ── Main container ────────────────────────────────────────────────────── */
  .contract-main {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem 4rem;
  }

  /* ── Page header ───────────────────────────────────────────────────────── */
  .page-header {
    padding: 1.5rem 0 0;
    margin-bottom: 1.75rem;
  }

  .page-header__row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: 0.75rem;
  }

  .page-header__lead {
    min-width: 0;
    flex: 1 1 260px;
  }

  .page-title {
    margin: 0;
    font-size: 1.75rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    line-height: 1.2;
    letter-spacing: -0.01em;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex-wrap: wrap;
  }

  .received-badge {
    font-size: 0.42em;
  }

  .page-header__counter {
    margin: 0.4rem 0 0;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .page-header__counter-name {
    color: var(--color-text-primary);
    font-weight: var(--font-weight-semibold);
  }

  .page-header__counter-dot { color: var(--color-text-muted); }

  .back-link {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-decoration: none;
    white-space: nowrap;
    display: inline-block;
  }

  .back-link:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  /* ── Stage Indicator Strip ─────────────────────────────────────────────── */
  .stage-strip {
    display: flex;
    align-items: flex-start;
    gap: 0;
    padding: 0.875rem 1.25rem;
    background: var(--color-bg-white);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    overflow-x: auto;
    flex: 0 1 auto;
    max-width: 100%;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .stage-strip--signed {
    border-color: #16a34a;
    box-shadow: 0 0 0 2px #dcfce7, var(--shadow-card);
  }

  @media (min-width: 768px) {
    .stage-strip { min-width: 460px; }
  }

  .stage-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    flex: 1;
    min-width: 72px;
  }

  .stage-connector {
    position: absolute;
    top: 16px; /* vertically centers with the 32px circle */
    left: calc(-50% + 0px);
    right: calc(50% + 16px);
    height: 2px;
    background: var(--color-border-default);
    z-index: 0;
  }

  .stage-connector--filled {
    background: var(--color-brand-mid);
  }

  .stage-circle {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    font-weight: var(--font-weight-bold);
    position: relative;
    z-index: 1;
    flex-shrink: 0;
    transition: background 0.2s ease;
  }

  .stage-circle--active {
    background: var(--color-accent);
    color: #FFFFFF;
  }

  .stage-circle--completed {
    background: var(--color-brand-mid);
    color: #FFFFFF;
  }

  .stage-circle--future {
    background: var(--color-border-default);
    color: var(--color-text-muted);
  }

  .stage-circle--declined {
    background: #FEE2E2;
    color: #991B1B;
  }

  .stage-label {
    font-size: 0.65rem;
    margin-top: 0.4rem;
    color: var(--color-text-muted);
    text-align: center;
    white-space: nowrap;
    letter-spacing: 0.02em;
  }

  .stage-label--active {
    color: var(--color-accent);
    font-weight: var(--font-weight-semibold);
  }

  .stage-label--declined {
    color: #991B1B;
    font-weight: var(--font-weight-semibold);
  }

  /* ── Next-action banner ────────────────────────────────────────────────── */
  /* ── Next-action hint — one compact line, no card ─────────────────────── */
  .next-action-hint {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 0.8rem;
    margin-bottom: 0.75rem;
  }
  .next-action-hint--active {
    color: var(--color-text-primary);
    font-weight: var(--font-weight-medium);
  }
  .next-action-hint--muted {
    color: var(--color-text-secondary);
  }
  .next-action-hint__text { flex: 1; }
  .next-action-hint__cta {
    background: none;
    border: none;
    padding: 0;
    font-size: inherit;
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent);
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .next-action-hint__cta:hover { text-decoration: underline; }

  /* ── Two-column body ───────────────────────────────────────────────────── */
  .contract-body {
    display: grid;
    grid-template-columns: 60% 1fr;
    gap: 1.75rem;
    align-items: start;
  }

  @media (max-width: 767px) {
    .contract-body {
      grid-template-columns: 1fr;
    }

    .col-right {
      order: 2;
    }
  }

  /* ── Cards — shared ─────────────────────────────────────────────────────── */
  .card {
    margin-bottom: 1.25rem;
  }

  .card-heading {
    margin-top: 0;
    margin-bottom: 1rem;
    font-size: 1.0625rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
  }

  .card-subtext {
    font-size: 0.9em;
    color: var(--color-text-muted);
    margin-top: 0.25rem;
    margin-bottom: 0;
  }

  /* ── Metadata card ─────────────────────────────────────────────────────── */
  .meta-card {
    padding: 1.25rem 1.5rem;
  }

  .meta-card__inner {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .meta-field {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    font-size: 0.9em;
  }

  .meta-label {
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
    min-width: 80px;
    flex-shrink: 0;
    text-transform: uppercase;
    font-size: 0.72em;
    letter-spacing: 0.04em;
  }

  .meta-value {
    color: var(--color-text-primary);
  }

  .meta-attachment {
    font-size: 0.85em;
  }

  /* ── Document viewer ───────────────────────────────────────────────────── */
  .doc-viewer {
    padding: 0;
    overflow: hidden;
    margin-bottom: 1.25rem;
  }

  .doc-viewer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.625rem 1rem;
    background: var(--color-bg-subtle);
    border-bottom: 1px solid var(--color-border-default);
    gap: 0.75rem;
  }

  .doc-viewer__tabs {
    display: inline-flex;
    align-items: center;
    gap: 0.125rem;
    padding: 0.2rem;
    background: var(--color-border-default);
    border-radius: var(--radius-pill);
    flex: 1;
  }

  .doc-viewer__tab {
    border: none;
    background: transparent;
    font: inherit;
    font-size: 0.78rem;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
    white-space: nowrap;
  }

  .doc-viewer__tab--active {
    background: var(--color-bg-white);
    color: var(--color-text-primary);
    box-shadow: var(--shadow-subtle);
  }

  .doc-viewer__download {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.78rem;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
    text-decoration: none;
    padding: 0.3rem 0.625rem;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-pill);
    transition: border-color 0.15s, color 0.15s;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .doc-viewer__download:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    text-decoration: none;
  }
  .doc-viewer__download--signed {
    background: none;
    cursor: pointer;
    border-color: #16a34a;
    color: #16a34a;
  }
  .doc-viewer__download--signed:hover {
    border-color: #15803d;
    color: #15803d;
  }

  .doc-viewer__body {
    background: var(--color-bg-white);
    position: relative;
  }

  .doc-viewer__iframe {
    display: block;
    width: 100%;
    height: 600px;
    border: none;
    background: #fff;
  }

  .doc-viewer__loading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    height: 600px;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .doc-viewer__spinner {
    width: 20px; height: 20px;
    border: 2px solid var(--color-border-default);
    border-top-color: var(--color-accent);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    flex-shrink: 0;
  }

  @keyframes spin { to { transform: rotate(360deg); } }

  .doc-viewer__error {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 200px;
    gap: 0.75rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    text-align: center;
  }

  .doc-diff-wrap {
    font-size: 0.875rem;
    padding: 1.25rem 1.5rem;
    max-height: 600px;
    overflow-y: auto;
  }

  /* ── Send-for-Review card (DRAFT → expand-in-place) ───────────────────── */
  .send-card { padding: 0; overflow: hidden; }

  .send-card__collapsed {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
  }
  .send-card[data-expanded="true"] .send-card__collapsed { display: none; }
  .send-card[data-expanded="false"] .send-card__expanded { display: none; }

  .send-card__icon {
    color: var(--color-accent);
    background: var(--color-border-light);
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .send-card__copy { flex: 1; min-width: 0; }

  .send-card__heading {
    margin: 0 0 0.25rem;
    font-size: 1.05rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
  }

  .send-card__body {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .send-card__cta { flex-shrink: 0; }

  .send-card__expanded {
    padding: 1.25rem 1.5rem;
    animation: send-expand 0.18s ease-out;
  }
  @keyframes send-expand {
    from { opacity: 0; transform: translateY(-2px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .send-card__expanded-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.875rem;
  }

  .send-card__collapse {
    background: none;
    border: none;
    color: var(--color-text-muted);
    font-size: 0.8rem;
    cursor: pointer;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-input);
    transition: background 0.15s ease;
  }
  .send-card__collapse:hover { background: var(--color-bg-subtle); color: var(--color-text-primary); }

  .send-card--ready .send-card__expanded-head {
    margin-bottom: 0.75rem;
  }

  .send-mode {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem;
    margin-bottom: 0.75rem;
    border-radius: var(--radius-pill);
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border-default);
  }

  .send-mode__option {
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-text-muted);
    font: inherit;
    font-size: 0.84rem;
    font-weight: var(--font-weight-semibold);
    padding: 0.4rem 0.8rem;
    min-width: 88px;
  }

  .send-mode__option--active {
    background: var(--color-bg-white);
    color: var(--color-text-primary);
    box-shadow: var(--shadow-subtle);
  }

  .send-mode__option:disabled {
    cursor: default;
  }

  .send-mode__hint {
    margin: -0.25rem 0 0.75rem;
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }

  .send-form { display: flex; flex-direction: column; gap: 0.625rem; }
  .send-form__field { display: flex; flex-direction: column; gap: 0.4rem; }
  .send-form__field .form-input { padding: 0.55rem 0.75rem; }

  .people-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.125rem 0 0.375rem;
  }

  .people-strip--signers {
    margin-top: 0.25rem;
  }

  .person-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    max-width: 100%;
    border: 1px solid var(--color-border-default);
    background: var(--color-bg-white);
    color: var(--color-text-primary);
    border-radius: var(--radius-pill);
    padding: 0.35rem 0.625rem;
    font: inherit;
    font-size: 0.82rem;
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .person-chip:hover {
    border-color: var(--color-accent);
    background: var(--color-bg-subtle);
  }

  .person-chip__label {
    font-weight: var(--font-weight-semibold);
    white-space: nowrap;
  }

  .person-chip__email {
    color: var(--color-text-muted);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .send-preview {
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-input);
    padding: 0.75rem 1rem;
    font-size: 0.85em;
    color: var(--color-text-muted);
    margin-top: 0.375rem;
  }

  .send-preview__head {
    font-size: 0.85em;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--color-border-default);
  }

  .send-preview__body {
    white-space: pre-wrap;
    line-height: 1.6;
  }

  .send-preview__var {
    color: var(--color-accent);
    font-weight: var(--font-weight-semibold);
  }

  .send-form__actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  /* ── Awaiting card (SENT/AI_PROCESSING) ─────────────────────────────────── */
  .awaiting-card {
    display: flex;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    align-items: flex-start;
  }

  .awaiting-card__icon {
    color: var(--color-text-muted);
    flex-shrink: 0;
    margin-top: 0.125rem;
  }

  .awaiting-card__copy { flex: 1; min-width: 0; }

  .awaiting-card__heading {
    margin: 0 0 0.25rem;
    font-size: 1rem;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }

  .awaiting-card__sub {
    margin: 0 0 0.5rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .awaiting-card__email {
    color: var(--color-text-primary);
    font-weight: var(--font-weight-semibold);
  }

  .awaiting-card__hint { margin: 0; }

  .ai-processing-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.875rem;
    background: var(--color-border-light);
    border: 1px solid var(--color-border-mid);
    border-radius: var(--radius-pill);
    font-size: 0.85rem;
    font-weight: var(--font-weight-semibold);
    color: var(--color-brand-deep);
    margin-bottom: 1.25rem;
  }

  /* ── Signing progress + timeline ─────────────────────────────────────────── */
  .signing-progress { margin-bottom: 1.25rem; }

  .signing-progress__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.625rem;
    flex-wrap: wrap;
  }

  .signing-progress__count {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .signer-timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 2px solid var(--color-border-default);
    padding-left: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .signer-tl-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    position: relative;
    padding-left: 0.875rem;
  }

  .signer-tl-dot {
    position: absolute;
    left: -1.05rem;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-white);
    border: 2px solid var(--color-border-default);
    font-size: 0.7rem;
    font-weight: var(--font-weight-bold);
    color: transparent;
    flex-shrink: 0;
  }

  .signer-tl-dot--signed {
    background: #16a34a;
    border-color: #16a34a;
    color: #FFFFFF;
  }
  .signer-tl-dot--viewed {
    background: var(--color-border-light);
    border-color: var(--color-accent);
  }
  .signer-tl-dot--declined {
    background: #dc2626;
    border-color: #dc2626;
    color: #FFFFFF;
  }

  .signer-tl-body { flex: 1; min-width: 0; }

  .signer-tl-status {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-weight: var(--font-weight-semibold);
    flex-shrink: 0;
  }

  .signing-foot {
    margin-top: 1rem;
    font-size: 0.8rem;
  }

  /* ── Completed card polish ──────────────────────────────────────────────── */
  .completed-card {
    text-align: center;
    padding: 1.75rem 1.5rem;
  }

  .completed-card__seal {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #DCFCE7;
    color: #166534;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    font-weight: var(--font-weight-bold);
    margin: 0 auto 0.875rem;
  }

  /* ── Status cards ──────────────────────────────────────────────────────── */
  .status-card {
    padding: 1.25rem 1.5rem;
  }

  .status-card--accent {
    border-left: 4px solid var(--color-accent);
    background: var(--color-border-light);
  }

  .status-card--success {
    border-left: 4px solid #16a34a;
  }

  .status-card--signed {
    border-left: 4px solid #16a34a;
    background: #f0fdf4;
  }

  .status-card--declined {
    border-left: 4px solid #dc2626;
    background: #FEF2F2;
  }

  .awaiting-row {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .awaiting-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
    line-height: 1;
  }

  .signed-heading {
    color: #166534;
    margin-top: 0;
    margin-bottom: 0.75rem;
    font-size: 1.0625rem;
    font-weight: var(--font-weight-bold);
  }

  .download-signed-btn {
    background: #16a34a;
    margin-top: 0.5rem;
  }

  .download-signed-btn:hover {
    background: #15803d;
  }

  .declined-heading {
    color: #991B1B;
    margin-top: 0;
    margin-bottom: 0.5rem;
    font-size: 1.0625rem;
    font-weight: var(--font-weight-bold);
  }

  .sign-now-heading {
    color: var(--color-brand-deep);
    margin-top: 0;
    margin-bottom: 0.5rem;
    font-size: 1.0625rem;
    font-weight: var(--font-weight-bold);
  }

  /* ── Spinner ─────────────────────────────────────────────────────────────── */
  @keyframes spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }

  .spinner-row {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .spinner {
    width: 20px;
    height: 20px;
    border: 2px solid var(--color-border-default);
    border-top-color: var(--color-accent);
    border-radius: 50%;
    animation: spin 1s linear infinite;
    flex-shrink: 0;
  }

  /* ── Skeleton placeholders (ai_processing state) ─────────────────────────── */
  .skeleton-stack { display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1.25rem; margin-top: 1rem; }
  .skeleton--summary { height: 80px; }
  .skeleton--diff { height: 300px; }

  /* ── Form — shared ────────────────────────────────────────────────────────── */
  .form-card {
    padding: 1.25rem 1.5rem;
  }

  .form-field {
    margin-bottom: 1rem;
  }

  .form-label {
    display: block;
    margin-bottom: 0.4rem;
    font-size: 0.875rem;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }

  .form-input {
    width: 100%;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-input);
    font-family: var(--font-family-base);
    font-size: 0.9375rem;
    color: var(--color-text-primary);
    background: var(--color-bg-white);
    box-sizing: border-box;
    transition: border-color 0.15s ease;
  }

  .form-input:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px var(--color-border-light);
  }

  textarea.form-input {
    resize: vertical;
  }

  .file-input {
    font-size: 0.85em;
    padding: 0.4rem 0.5rem;
  }

  /* ── AI Analysis card ─────────────────────────────────────────────────── */
  .ai-card {
    padding: 1.25rem 1.5rem;
    background: var(--color-border-light);
    border: 1px solid var(--color-border-mid);
  }

  .ai-card__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .ai-card__title-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .ai-card__header .card-heading {
    margin-bottom: 0;
  }

  .ai-badge {
    background: linear-gradient(180deg, #6C81FA 35%, #5D58FF 53%, #673AB7 90%);
    color: #FFFFFF;
    font-size: 0.65rem;
