  .wizard-summary__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .wizard-summary__list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
