  .sign-confirm__add-btn:hover {
    background: var(--color-bg-subtle);
  }
  /* Button fills the card width like the other send buttons */
  .sign-confirm .wizard-actions .btn-primary.btn-lg {
    flex: 1;
  }

  /* ── Thread review link button ─────────────────────────────────────── */
  .thread-review-link {
    display: inline-block;
    margin-top: 0.5rem;
    text-decoration: none;
  }

  /* ── Signing roster ───────────────────────────────────────────────────── */
  .signer-roster {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .signer-row-status {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.9em;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-bg-subtle);
  }

  .signer-row-status:last-child {
    border-bottom: none;
