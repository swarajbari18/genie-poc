    background: var(--color-bg-white);
    font-size: 0.85rem;
  }

  .signer-card__remove {
    background: none;
    border: 1px solid var(--color-border-default);
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1;
    cursor: pointer;
    padding: 0;
    width: 26px;
    height: 26px;
    border-radius: var(--radius-input);
