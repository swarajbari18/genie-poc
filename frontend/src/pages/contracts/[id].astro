  .wizard-pip--active {
    background: var(--color-accent);
    color: var(--color-text-on-dark);
  }
  .wizard-pip--done {
    background: var(--color-brand-mid);
    color: var(--color-text-on-dark);
  }

  .wizard-step-label {
    font-size: 0.875rem;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin-left: 0.25rem;
