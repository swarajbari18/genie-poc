  }

  .wizard-summary__role {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    margin-left: 0.25rem;
  }

  .wizard-note { padding: 0.25rem 0; }

  .wizard-note__toggle {
    cursor: pointer;
